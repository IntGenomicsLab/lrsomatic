nextflow_function {

    name "Test VEP plugin resolution functions"
    script "../main.nf"
    // "small" is what .github/workflows/nf-test.yml selects on for pull_request
    tag "small"
    tag "subworkflows"
    tag "subworkflows_local"
    tag "utils_nfcore_lrsomatic_pipeline"
    tag "vep_plugins"

    // Launch-time resolution only: nothing is staged and nothing touches the network.

    // --- vepPluginResource: an explicit --vep_* wins over the igenomes default

    test("vepPluginResource falls back to the per-assembly default") {

        function "vepPluginResource"

        when {
            params {
                genome = 'GRCh38'
            }
            function {
                """
                input[0] = 'vep_clinvar'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.toString().contains('clinvar') },
                // pinned to a dated release, never the rolling vcf_GRCh38/clinvar.vcf.gz
                { assert function.result.toString().contains('archive_2.0') }
            )
        }
    }

    test("vepPluginResource prefers an explicit param over the default") {

        function "vepPluginResource"

        when {
            params {
                genome = 'GRCh38'
                vep_clinvar = '/data/mine/clinvar.vcf.gz'
            }
            function {
                """
                input[0] = 'vep_clinvar'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == '/data/mine/clinvar.vcf.gz' }
            )
        }
    }

    test("vepPluginResource is null with no param and no genome") {

        function "vepPluginResource"

        when {
            params {
                genome = null
            }
            function {
                """
                input[0] = 'vep_clinvar'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == null }
            )
        }
    }

    // --- vepPluginIndex: overriding a data file drops the inherited index

    test("vepPluginIndex takes the default index when the data file is the default") {

        function "vepPluginIndex"

        when {
            params {
                genome = 'GRCh38'
            }
            function {
                """
                input[0] = 'vep_clinvar'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.toString().endsWith('.tbi') }
            )
        }
    }

    test("vepPluginIndex drops the default index once the data file is overridden") {

        function "vepPluginIndex"

        when {
            params {
                genome = 'GRCh38'
                vep_clinvar = '/data/mine/clinvar.vcf.gz'
            }
            function {
                """
                input[0] = 'vep_clinvar'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                // an index belongs to the file it was built from, so ours must not be paired with theirs
                { assert function.result == null }
            )
        }
    }

    test("vepPluginIndex returns an explicitly supplied index") {

        function "vepPluginIndex"

        when {
            params {
                genome = 'GRCh38'
                vep_clinvar = '/data/mine/clinvar.vcf.gz'
                vep_clinvar_tbi = '/data/mine/clinvar.vcf.gz.tbi'
            }
            function {
                """
                input[0] = 'vep_clinvar'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == '/data/mine/clinvar.vcf.gz.tbi' }
            )
        }
    }

    test("vepPluginIndex is null for a resource that takes no index") {

        function "vepPluginIndex"

        when {
            params {
                genome = 'CHM13'
            }
            function {
                """
                input[0] = 'vep_polyphen_sift_db'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == null }
            )
        }
    }

    // --- vepPluginNeedsPrep / vepPluginPreparedName: the release-zip split

    test("vepPluginNeedsPrep is true for a REVEL release zip") {

        function "vepPluginNeedsPrep"

        when {
            params {
                genome = null
                vep_revel = 'https://rothsj06.dmz.hpc.mssm.edu/revel-v1.3_all_chromosomes.zip'
            }
            function {
                """
                input[0] = 'vep_revel'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == true }
            )
        }
    }

    test("vepPluginNeedsPrep is true for the EVE bulk download endpoint") {

        function "vepPluginNeedsPrep"

        when {
            params {
                genome = null
                // the documented way to enable EVE; it carries no file extension at all
                vep_eve = 'https://evemodel.org/api/proteins/bulk/download/'
            }
            function {
                """
                input[0] = 'vep_eve'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == true }
            )
        }
    }

    test("vepPluginNeedsPrep is false for an already-prepared EVE VCF") {

        function "vepPluginNeedsPrep"

        when {
            params {
                genome = null
                vep_eve = '/data/vep/eve_merged.vcf.gz'
            }
            function {
                """
                input[0] = 'vep_eve'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert !function.result }
            )
        }
    }

    test("vepPluginNeedsPrep is false for an already-prepared REVEL file") {

        function "vepPluginNeedsPrep"

        when {
            params {
                genome = null
                vep_revel = '/data/vep/revel_grch38.tsv.gz'
            }
            function {
                """
                input[0] = 'vep_revel'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert !function.result }
            )
        }
    }

    test("vepPluginNeedsPrep is false for a resource that is never prepared") {

        function "vepPluginNeedsPrep"

        when {
            params {
                genome = null
                vep_clinvar = '/data/vep/whatever.zip'
            }
            function {
                """
                input[0] = 'vep_clinvar'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert !function.result }
            )
        }
    }

    test("vepPluginPreparedName names the file the prep task writes") {

        function "vepPluginPreparedName"

        when {
            function {
                """
                input[0] = 'vep_eve'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == 'eve_merged.vcf.gz' }
            )
        }
    }

    // --- resolveVepPlugins

    test("resolveVepPlugins returns nothing when plugins are skipped") {

        function "resolveVepPlugins"

        when {
            params {
                genome = 'GRCh38'
                skip_vep_plugins = true
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.args == '' },
                { assert function.result.ready_files == [] },
                { assert function.result.prepare == [:] }
            )
        }
    }

    test("resolveVepPlugins returns nothing when skip_vep is set") {

        function "resolveVepPlugins"

        when {
            params {
                genome = 'GRCh38'
                skip_vep = true
                skip_vep_plugins = false
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.args == '' }
            )
        }
    }

    test("resolveVepPlugins defers a release zip to the prep task") {

        function "resolveVepPlugins"

        when {
            params {
                genome = null
                skip_vep_plugins = false
                vep_revel = 'https://rothsj06.dmz.hpc.mssm.edu/revel-v1.3_all_chromosomes.zip'
            }
        }

        then {
            assertAll(
                { assert function.success },
                // the argument names what the prep task will write, not the zip
                { assert function.result.args == '--plugin REVEL,file=revel_grch38.tsv.gz' },
                { assert function.result.prepare['vep_revel'].toString().endsWith('.zip') },
                // a zip is never staged as a file: neither release host can be staged by Nextflow
                { assert function.result.ready_files == [] }
            )
        }
    }

    test("resolveVepPlugins emits no plugin args when nothing resolves") {

        function "resolveVepPlugins"

        when {
            params {
                genome = null
                skip_vep_plugins = false
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.args == '' },
                { assert function.result.prepare == [:] }
            )
        }
    }

    // --- validateVepPluginParams: the error paths

    test("validateVepPluginParams passes when plugins are skipped") {

        function "validateVepPluginParams"

        when {
            params {
                genome = 'GRCh38'
                skip_vep_plugins = true
            }
        }

        then {
            assert function.success
        }
    }

    test("validateVepPluginParams rejects a data file set without its index") {

        function "validateVepPluginParams"

        when {
            params {
                genome = null
                skip_vep_plugins = false
                vep_alphamissense = '/data/vep/AlphaMissense_hg38.tsv.gz'
            }
        }

        then {
            assertAll(
                { assert function.failed },
                { assert function.stdout.any { line -> line.contains('vep_alphamissense_tbi') } }
            )
        }
    }

    test("validateVepPluginParams rejects an index supplied alongside a release zip") {

        function "validateVepPluginParams"

        when {
            params {
                genome = null
                skip_vep_plugins = false
                vep_revel = 'https://rothsj06.dmz.hpc.mssm.edu/revel-v1.3_all_chromosomes.zip'
                vep_revel_tbi = '/data/vep/revel_grch38.tsv.gz.tbi'
            }
        }

        then {
            assertAll(
                // the prep task indexes what it writes, so a supplied index would be discarded
                { assert function.failed },
                { assert function.stdout.any { line -> line.contains('vep_revel_tbi') } }
            )
        }
    }

    test("validateVepPluginParams rejects a GRCh38-only resource on CHM13") {

        function "validateVepPluginParams"

        when {
            params {
                genome = null
                skip_vep_plugins = false
                vep_genome = 'T2T-CHM13v2.0'
                vep_revel = '/data/vep/revel_grch38.tsv.gz'
                vep_revel_tbi = '/data/vep/revel_grch38.tsv.gz.tbi'
            }
        }

        then {
            assertAll(
                { assert function.failed },
                { assert function.stdout.any { line -> line.contains('GRCh38-only') } }
            )
        }
    }

    test("validateVepPluginParams rejects the protein-space table off CHM13") {

        function "validateVepPluginParams"

        when {
            params {
                genome = null
                skip_vep_plugins = false
                vep_genome = 'GRCh38'
                vep_alphamissense_aa = '/data/vep/alphamissense_protein.tsv.gz'
                vep_alphamissense_aa_tbi = '/data/vep/alphamissense_protein.tsv.gz.tbi'
            }
        }

        then {
            assertAll(
                { assert function.failed },
                { assert function.stdout.any { line -> line.contains('vep_alphamissense_aa') } }
            )
        }
    }

    test("validateVepPluginParams names no assembly when vep_genome is unset") {

        function "validateVepPluginParams"

        when {
            params {
                genome = null
                skip_vep_plugins = false
                vep_genome = null
                vep_alphamissense_aa = '/data/vep/alphamissense_protein.tsv.gz'
                vep_alphamissense_aa_tbi = '/data/vep/alphamissense_protein.tsv.gz.tbi'
            }
        }

        then {
            assertAll(
                { assert function.failed },
                // "On null use --vep_alphamissense" would be the regression here
                { assert function.stdout.every { line -> !line.contains('On null') } }
            )
        }
    }

    test("validateVepPluginParams rejects vep_custom with no --custom entry to substitute into") {

        function "validateVepPluginParams"

        when {
            params {
                genome = null
                skip_vep_plugins = false
                vep_custom = '/data/mine/track.vcf.gz'
                vep_args = '--everything --offline --format vcf --vcf'
            }
        }

        then {
            assertAll(
                // without this the module would rewrite the ClinVar --custom entry instead
                { assert function.failed },
                { assert function.stdout.any { line -> line.contains('vep_custom') } }
            )
        }
    }

    test("validateVepPluginParams accepts vep_custom with a matching --custom entry") {

        function "validateVepPluginParams"

        when {
            params {
                genome = null
                skip_vep_plugins = false
                vep_custom = '/data/mine/track.vcf.gz'
                vep_args = '--everything --offline --format vcf --vcf --custom file=placeholder,short_name=MyTrack,format=vcf,type=exact,coords=0'
            }
        }

        then {
            assert function.success
        }
    }
}
