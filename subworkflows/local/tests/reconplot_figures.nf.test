nextflow_workflow {

    name "Test Workflow RECONPLOT_FIGURES"
    script "../reconplot_figures.nf"
    workflow "RECONPLOT_FIGURES"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "reconplot_figures"
    // "small" is what .github/workflows/nf-test.yml selects on for pull_request
    tag "small"

    // ReConPlot needs whole-genome caller output, so the pipeline tests skip it. Under -stub what is
    // tested is the pairing: ASCAT + Severus, the top-ranked Wakhan solution + Severus, SAVANA alone
    // (with or without allele counts), and that a SAVANA sample with allele counts but no fit is dropped.

    test("each CN/SV caller pair forms per sample, no-fit SAVANA samples are dropped") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                // Empty stand-ins carrying the real callers' file names; ReConPlot's stub does not read them
                def mk = { String rel, String text = '' -> def f = file("\${launchDir}/fixtures/\${rel}"); f.parent.mkdirs(); f.text = text; return f }
                // ASCAT segments with data; an ASCAT run without a solution writes an empty segments.txt
                // Wakhan >= 0.5 ranked solution directories holding integer_profile.bed (rank 1 is drawn)
                def rank = { String rel -> mk(rel + '/integer_profile.bed'); return file("\${launchDir}/fixtures/\${rel}") }
                def seg = 'sample\\tchr\\tstartpos\\tendpos\\tnMajor\\tnMinor\\nt\\t1\\t1\\t1000\\t1\\t1\\n'
                def s1 = [ id:'sample1', paired_data:true,  platform:'ont' ]
                def s2 = [ id:'sample2', paired_data:true,  platform:'pb'  ]
                def s3 = [ id:'sample3', paired_data:false, platform:'ont' ]
                def s4 = [ id:'sample4', paired_data:false, platform:'ont' ]

                // Severus somatic SVs for both paired samples and the tumour-only sample3
                input[0] = channel.of(
                    [ s1, mk('severus/sample1/severus_somatic.vcf.gz') ],
                    [ s2, mk('severus/sample2/severus_somatic.vcf.gz') ],
                    [ s3, mk('severus/sample3/severus_somatic.vcf.gz') ]
                )
                // ASCAT for sample1 (paired: tumour + normal BAF) and sample3 (tumour-only: ASCAT runs for it too, tumour BAF only)
                // ... and sample2, whose ASCAT found no solution (empty segments.txt): its ASCAT pair must not form
                input[1] = channel.of([ s1, mk('ascat/sample1.segments.txt', seg) ], [ s2, mk('ascat/sample2.segments.txt') ], [ s3, mk('ascat/sample3.segments.txt', seg) ])
                input[2] = channel.of([ s1, mk('ascat/sample1.purityploidy.txt') ], [ s2, mk('ascat/sample2.purityploidy.txt') ], [ s3, mk('ascat/sample3.purityploidy.txt') ])
                input[3] = channel.of(
                    [ s1, [ mk('ascat/sample1.tumour_tumourBAF.txt'), mk('ascat/sample1.tumour_normalBAF.txt') ] ],
                    [ s2, [ mk('ascat/sample2.tumour_tumourBAF.txt') ] ],
                    [ s3, [ mk('ascat/sample3.tumour_tumourBAF.txt') ] ]
                )
                // Wakhan: sample1 has two solutions (solution_1's two HP beds must be picked); sample2 has one HP bed only
                input[4] = channel.of(
                    [ s1, [ rank('wakhan/sample1/solution_rank_1'), rank('wakhan/sample1/solution_rank_2') ] ],
                    [ s2, [ rank('wakhan/sample2/solution_rank_2') ] ]
                )
                input[5] = channel.of(
                    [ s1, mk('wakhan/sample1/solutions_ranks.tsv') ],
                    [ s2, mk('wakhan/sample2/solutions_ranks.tsv') ]
                )
                // SAVANA: fits for sample1 and sample3; sample4 has allele counts but no fit
                input[6] = channel.of(
                    [ s1, mk('savana/sample1/sample1_segmented_absolute_copy_number.tsv') ],
                    [ s3, mk('savana/sample3/sample3_segmented_absolute_copy_number.tsv') ]
                )
                input[7] = channel.of(
                    [ s1, mk('savana/sample1/sample1.classified.somatic.bedpe') ],
                    [ s3, mk('savana/sample3/sample3.classified.somatic.bedpe') ]
                )
                input[8] = channel.of(
                    [ s1, mk('savana/sample1/sample1_fitted_purity_ploidy.tsv') ],
                    [ s3, mk('savana/sample3/sample3_fitted_purity_ploidy.tsv') ]
                )
                input[9] = channel.of(
                    [ s1, mk('savana/sample1/sample1_allele_counts_hetSNPs.bed') ],
                    [ s4, mk('savana/sample4/sample4_allele_counts_hetSNPs.bed') ]
                )
                input[10] = 'hg38'
                """
            }
        }

        then {
            def tasks = workflow.trace.tasks().collect { task -> task.name }
            // conf/modules.config publishes each task's <prefix>/ under <outdir>/<sample>/reconplot/;
            // the stub lists what was staged into cn_input/ and sv_input/
            def staged = { String rel -> path("$outputDir/${rel}/staged.txt").text.trim().split('\n') as List }

            assertAll(
                { assert workflow.success },
                // ASCAT + Severus: paired sample1 and tumour-only sample3 (ASCAT runs for tumour-only samples on dev)
                { assert tasks.count { name -> name.contains('RECONPLOT_SEVERUS_ASCAT') } == 2 },
                { assert tasks.any { name -> name.contains('RECONPLOT_SEVERUS_ASCAT (sample1:') } },
                { assert tasks.any { name -> name.contains('RECONPLOT_SEVERUS_ASCAT (sample3:') } },
                { assert !tasks.any { name -> name.contains('RECONPLOT_SEVERUS_ASCAT (sample2:') } },   // ASCAT found no solution
                { assert staged('sample1/reconplot/severus_ascat') == ['cn_input/sample1.purityploidy.txt', 'cn_input/sample1.segments.txt',
                                                                       'cn_input/sample1.tumour_normalBAF.txt', 'cn_input/sample1.tumour_tumourBAF.txt',
                                                                       'sv_input/severus_somatic.vcf.gz'] },
                { assert staged('sample3/reconplot/severus_ascat') == ['cn_input/sample3.purityploidy.txt', 'cn_input/sample3.segments.txt',
                                                                       'cn_input/sample3.tumour_tumourBAF.txt', 'sv_input/severus_somatic.vcf.gz'] },
                // Wakhan + Severus: sample1 only (sample2 has only a rank-2 profile); rank 1's integer_profile.bed + the ranks
                { assert tasks.count { name -> name.contains('RECONPLOT_SEVERUS_WAKHAN') } == 1 },
                { assert tasks.any { name -> name.contains('RECONPLOT_SEVERUS_WAKHAN (sample1:') } },
                { assert staged('sample1/reconplot/severus_wakhan') == ['cn_input/integer_profile.bed', 'cn_input/solutions_ranks.tsv', 'sv_input/severus_somatic.vcf.gz'] },
                // SAVANA: sample1 (with allele counts) and sample3 (without); sample4 has no fit and is dropped
                { assert tasks.count { name -> name.contains('RECONPLOT_SAVANA') } == 2 },
                { assert tasks.any { name -> name.contains('RECONPLOT_SAVANA (sample1:') } },
                { assert tasks.any { name -> name.contains('RECONPLOT_SAVANA (sample3:') } },
                { assert staged('sample1/reconplot/savana') == ['cn_input/sample1.classified.somatic.bedpe', 'cn_input/sample1_allele_counts_hetSNPs.bed',
                                                                'cn_input/sample1_fitted_purity_ploidy.tsv', 'cn_input/sample1_segmented_absolute_copy_number.tsv'] },
                { assert staged('sample3/reconplot/savana') == ['cn_input/sample3.classified.somatic.bedpe', 'cn_input/sample3_fitted_purity_ploidy.tsv',
                                                                'cn_input/sample3_segmented_absolute_copy_number.tsv'] },
                { assert !tasks.any { name -> name.contains('(sample4:') } },
                { assert workflow.out.versions.size() >= 1 }
            )
        }
    }
}
