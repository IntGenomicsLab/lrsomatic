nextflow_workflow {

    name "Test Workflow PADFOOT_ANNOTATION"
    script "../padfoot_annotation.nf"
    workflow "PADFOOT_ANNOTATION"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "padfoot_annotation"
    // "small" is what .github/workflows/nf-test.yml selects on for pull_request
    tag "small"

    // Padfoot needs whole-genome caller output, so the pipeline tests skip it. Under -stub what is
    // tested is the pairing: Severus SVs + the top-ranked Wakhan solution, SAVANA SVs + SAVANA copy
    // number, that a sample missing one side of a pair is dropped rather than failing the run, and
    // which files each task actually received (the stub lists them in <prefix>/staged.txt).

    test("Severus + Wakhan and SAVANA pairs form per sample") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                // Empty stand-ins carrying the real callers' file names; Padfoot's stub does not read them
                def mk = { String rel -> def f = file("\${launchDir}/fixtures/\${rel}"); f.parent.mkdirs(); f.text = ''; return f }
                def s1 = [ id:'sample1', paired_data:true,  platform:'ont' ]
                def s2 = [ id:'sample2', paired_data:true,  platform:'pb'  ]
                def s3 = [ id:'sample3', paired_data:false, platform:'ont' ]

                // Severus somatic SVs for both paired samples
                input[0] = channel.of(
                    [ s1, mk('severus/sample1/severus_somatic.vcf.gz') ],
                    [ s2, mk('severus/sample2/severus_somatic.vcf.gz') ]
                )
                // Wakhan >= 0.5 ranked solution directories (solution_rank_N/integer_profile.vcf): sample1 has two
                // (rank 1 must be picked); sample2 has only a rank-2 profile, so no pair forms for it
                def rank = { String rel -> mk(rel + '/integer_profile.vcf'); return file("\${launchDir}/fixtures/\${rel}") }
                input[1] = channel.of(
                    [ s1, [ rank('wakhan/sample1/solution_rank_1'), rank('wakhan/sample1/solution_rank_2') ] ],
                    [ s2, [ rank('wakhan/sample2/solution_rank_2') ] ]
                )
                // Wakhan purity/ploidy ranks: sample1, and sample2 without a usable profile -- that row exists only on the
                // right of the remainder join and must be dropped, not crash the run
                input[2] = channel.of([ s1, mk('wakhan/sample1/solutions_ranks.tsv') ], [ s2, mk('wakhan/sample2/solutions_ranks.tsv') ])
                // SAVANA: SVs for sample1 and sample3, a copy-number fit for sample1 only; sample3 also has a fit table
                // without copy number (right-only in the remainder join)
                input[3] = channel.of(
                    [ s1, mk('savana/sample1/sample1.classified.somatic.vcf') ],
                    [ s3, mk('savana/sample3/sample3.classified.somatic.vcf') ]
                )
                input[4] = channel.of([ s1, mk('savana/sample1/sample1_segmented_absolute_copy_number.tsv') ])
                input[5] = channel.of([ s1, mk('savana/sample1/sample1_fitted_purity_ploidy.tsv') ], [ s3, mk('savana/sample3/sample3_fitted_purity_ploidy.tsv') ])
                input[6] = channel.value([ [:], mk('ref/genome.fasta') ])
                input[7] = channel.value([ [:], mk('ref/genome.fasta.fai') ])
                input[8] = channel.value([ [:], 'hg38', [], [] ])
                """
            }
        }

        then {
            def tasks = workflow.trace.tasks().collect { task -> task.name }
            // conf/modules.config publishes each task's <prefix>/ under <outdir>/<sample>/padfoot/
            def staged = { String rel -> path("$outputDir/${rel}/staged.txt").text.trim().split('\n') as List }

            assertAll(
                { assert workflow.success },
                // sample1 only: sample2 has no rank-1 integer profile to pair with
                { assert tasks.count { name -> name.contains('PADFOOT_SEVERUS_WAKHAN') } == 1 },
                { assert tasks.any { name -> name.contains('PADFOOT_SEVERUS_WAKHAN (sample1:') } },
                // ... and it received the Severus VCF, the top-ranked integer profile and the ranks
                { assert staged('sample1/padfoot/severus_wakhan') == ['severus_somatic.vcf.gz', 'integer_profile.vcf', 'solutions_ranks.tsv'] },
                // sample1 only: sample3 has SAVANA SVs but no copy-number fit
                { assert tasks.count { name -> name.contains('PADFOOT_SAVANA') } == 1 },
                { assert tasks.any { name -> name.contains('PADFOOT_SAVANA (sample1:') } },
                { assert staged('sample1/padfoot/savana') == ['sample1.classified.somatic.vcf', 'sample1_segmented_absolute_copy_number.tsv', 'sample1_fitted_purity_ploidy.tsv'] },
                { assert workflow.out.versions.size() >= 1 }
            )
        }
    }
}
