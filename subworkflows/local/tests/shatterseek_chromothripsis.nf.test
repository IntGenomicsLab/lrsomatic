nextflow_workflow {

    name "Test Workflow SHATTERSEEK_CHROMOTHRIPSIS"
    script "../shatterseek_chromothripsis.nf"
    workflow "SHATTERSEEK_CHROMOTHRIPSIS"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "shatterseek_chromothripsis"
    // "small" is what .github/workflows/nf-test.yml selects on for pull_request
    tag "small"

    // ShatterSeek needs whole-genome caller output, so the pipeline tests skip it. Under -stub what is tested is the
    // pairing: ASCAT + Severus, the top-ranked Wakhan solution + Severus, SAVANA alone, and that an ASCAT run without
    // a solution or a Wakhan run without a rank-1 profile forms no pair.

    test("each CN/SV caller pair forms per sample") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                // Empty stand-ins carrying the real callers' file names; the stub does not read them
                def mk = { String rel, String text = '' -> def f = file("\${launchDir}/fixtures/\${rel}"); f.parent.mkdirs(); f.text = text; return f }
                def rank = { String rel -> mk.call(rel + '/integer_profile.bed'); return file("\${launchDir}/fixtures/\${rel}") }
                def seg = 'sample\\tchr\\tstartpos\\tendpos\\tnMajor\\tnMinor\\nt\\t1\\t1\\t1000\\t1\\t1\\n'
                def s1 = [ id:'sample1', paired_data:true,  platform:'ont' ]
                def s2 = [ id:'sample2', paired_data:true,  platform:'pb'  ]
                def s3 = [ id:'sample3', paired_data:false, platform:'ont' ]

                input[0] = channel.of(
                    [ s1, mk.call('severus/sample1/severus_somatic.vcf.gz') ],
                    [ s2, mk.call('severus/sample2/severus_somatic.vcf.gz') ],
                    [ s3, mk.call('severus/sample3/severus_somatic.vcf.gz') ]
                )
                // sample2's ASCAT found no solution (empty segments.txt): its ASCAT pair must not form
                input[1] = channel.of([ s1, mk.call('ascat/sample1.segments.txt', seg) ], [ s2, mk.call('ascat/sample2.segments.txt') ], [ s3, mk.call('ascat/sample3.segments.txt', seg) ])
                // Wakhan >= 0.5: sample1 has two ranked solutions (rank 1 is used); sample2 has only a rank-2 profile
                input[2] = channel.of(
                    [ s1, [ rank.call('wakhan/sample1/solution_rank_1'), rank.call('wakhan/sample1/solution_rank_2') ] ],
                    [ s2, [ rank.call('wakhan/sample2/solution_rank_2') ] ]
                )
                input[3] = channel.of(
                    [ s1, mk.call('savana/sample1/sample1_segmented_absolute_copy_number.tsv') ],
                    [ s3, mk.call('savana/sample3/sample3_segmented_absolute_copy_number.tsv') ]
                )
                input[4] = channel.of(
                    [ s1, mk.call('savana/sample1/sample1.classified.somatic.vcf') ],
                    [ s3, mk.call('savana/sample3/sample3.classified.somatic.vcf') ]
                )
                input[5] = 'hg38'
                """
            }
        }

        then {
            def tasks = workflow.trace.tasks().collect { task -> task.name }
            // conf/modules.config publishes each task's <prefix>/ under <outdir>/<sample>/shatterseek/;
            // the stub lists what was staged into cn_input/ and sv_input/
            def staged = { String rel -> path("$outputDir/${rel}/staged.txt").text.trim().split('\n') as List }

            assertAll(
                { assert workflow.success },
                { assert tasks.count { name -> name.contains('SHATTERSEEK_SEVERUS_ASCAT') } == 2 },
                { assert tasks.any { name -> name.contains('SHATTERSEEK_SEVERUS_ASCAT (sample1:') } },
                { assert tasks.any { name -> name.contains('SHATTERSEEK_SEVERUS_ASCAT (sample3:') } },
                { assert staged('sample1/shatterseek/severus_ascat') == ['cn_input/sample1.segments.txt', 'sv_input/severus_somatic.vcf.gz'] },
                { assert tasks.count { name -> name.contains('SHATTERSEEK_SEVERUS_WAKHAN') } == 1 },
                { assert staged('sample1/shatterseek/severus_wakhan') == ['cn_input/integer_profile.bed', 'sv_input/severus_somatic.vcf.gz'] },
                { assert tasks.count { name -> name.contains('SHATTERSEEK_SAVANA') } == 2 },
                { assert staged('sample3/shatterseek/savana') == ['cn_input/sample3.classified.somatic.vcf', 'cn_input/sample3_segmented_absolute_copy_number.tsv'] },
                { assert !tasks.any { name -> name.contains('(sample2:') } },
                { assert workflow.out.summary.size() == 5 },
                { assert workflow.out.versions.size() >= 1 }
            )
        }
    }
}
