// conf/modules.config's DMR selectors don't apply in this nf-test, so set ext.* here
process {
    withName: 'MODKIT_PILEUP' {
        ext.args = '--phased --modified-bases 5mC 5hmC'
    }
    withName: '.*HTSLIB_BGZIPTABIX' {
        // Avoid an hp1/hp2 filename collision
        ext.prefix = { "${meta.id}_${meta.haplotype}" }
        ext.args2 = '-p bed'
    }
    withName: '.*MODKIT_DMR' {
        ext.args = '--base C'
    }
}
