// The fixture BAM is ~4x, so the tumour-only guard (3 tagged reads on the other haplotype) would leave nothing to
// compare with the germline phase; the guard itself is tested in modules/local/phase_somatic_from_reads.
process {
    withName: '.*:PHASING_HAPLOTYPING:PHASE_SOMATIC_FROM_READS' {
        ext.args = '--min-reads 3 --min-fraction 0.8'
    }
}
