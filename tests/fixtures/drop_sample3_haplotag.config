// tests/report_without_severus.nf.test: stands in for a sample lost upstream of SEVERUS (e.g. by an
// errorStrategy 'ignore' leg). sample3 is never haplotagged, so it never reaches severus_input, while its
// QC and phasing outputs still reach the report's joins.
process {
    withName: '.*:LONGPHASE_HAPLOTAG' {
        ext.when = { meta.id != 'sample3' }
    }
}
