// Test-only config for tests/smallvar_wiring.nf.test. Stub scripts never use ext.args, so a -stub run cannot show which
// withName selector matched a task. Each task below therefore writes the ext settings conf/modules.config resolved for it,
// and the files it was given, to .ext_record in its work directory (base64 in the command, so the quotes in the args
// survive). Only beforeScript is set: the selectors under test stay exactly as the pipeline has them.
process {
    withName: '.*_PASS_FILTER' {
        beforeScript = { 'echo ' + ['args=' + task.ext.args, 'prefix=' + task.ext.prefix].join('\n').bytes.encodeBase64().toString() + ' | base64 -d > .ext_record' }
    }
    withName: '.*:BCFTOOLS_CALLER_UNION' {
        beforeScript = { 'echo ' + ['args=' + task.ext.args, 'prefix=' + task.ext.prefix, 'prio=' + prio_vcf, 'other=' + other_vcf].join('\n').bytes.encodeBase64().toString() + ' | base64 -d > .ext_record' }
    }
    withName: '.*:BCFTOOLS_CALLER_CONSENSUS|.*:DS_GERMLINE_SELECT' {
        beforeScript = { 'echo ' + ['args=' + task.ext.args, 'args2=' + task.ext.args2, 'prefix=' + task.ext.prefix, 'prio=' + prio_vcf, 'other=' + other_vcf, 'fasta=' + fasta, 'fai=' + fai].join('\n').bytes.encodeBase64().toString() + ' | base64 -d > .ext_record' }
    }
}
