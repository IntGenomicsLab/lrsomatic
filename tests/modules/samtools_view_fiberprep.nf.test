nextflow_process {

    name "Test Process SAMTOOLS_VIEW as SAMTOOLS_VIEW_FIBERPREP"
    script "../../modules/nf-core/samtools/view/main.nf"
    process "SAMTOOLS_VIEW"
    config "./samtools_view_fiberprep.config"

    tag "modules"
    tag "samtools_view_fiberprep"
    tag "cram_input"
    tag "fiberseq"
    tag "small"

    // The workflow runs nf-core samtools/view with -F 0x900 on aligned input before fibertools-rs, which takes no
    // reference and panics on secondary alignments with SEQ '*'. The inputs are built from the CHM13 chr19 HiFi test
    // BAM, which has supplementary but no secondary records: five secondary copies are added (tests/modules/cram_fixtures.nf),
    // and that BAM is also written as CRAM with and without the reference embedded, the UR: path then deleted. The
    // config blocks REF_PATH and REF_CACHE. primary_only.bam (the test BAM without its supplementary records) goes
    // through the filter unchanged and is what every other input must come out as, compared on the first 11 SAM
    // columns (CRAM decoding regenerates MD/NM).

    setup {
        run("CRAM_FIXTURES") {
            script "./cram_fixtures.nf"
            process {
                """
                input[0] = [
                    [ id:'HS578T' ],
                    file('https://raw.githubusercontent.com/IntGenomicsLab/test-datasets/main/data/aligned/HS578T_HIFI_CHM13_chr19.bam', checkIfExists: true),
                    file('https://raw.githubusercontent.com/IntGenomicsLab/test-datasets/main/references/CHM13V2_maskedY_rCRS_chr19.fa.gz', checkIfExists: true),
                    file('https://raw.githubusercontent.com/IntGenomicsLab/test-datasets/main/references/GRCh38_chr19.fasta.gz', checkIfExists: true)
                ]
                """
            }
        }
    }

    test("aligned BAM and embedded-reference CRAM with secondaries, no FASTA - primary records only") {

        when {
            process {
                """
                input[0] = CRAM_FIXTURES.out.secondary_bam.map { _meta, f -> [ [ id:'bam' ], f, [] ] }
                    .mix(CRAM_FIXTURES.out.secondary_embedded.map { _meta, f -> [ [ id:'embedded' ], f, [] ] })
                    .mix(CRAM_FIXTURES.out.primary_only.map { _meta, f -> [ [ id:'expected' ], f, [] ] })
                input[1] = [ [:], [], [] ]
                input[2] = [ [:], [] ]
                input[3] = [ [:], [] ]
                input[4] = ''
                """
            }
        }

        then {
            def lines = process.out.bam.collectEntries { meta, out -> [ (meta.id): bam(out.toString(), stringency: 'silent').getSamLines() ] }
            def flagged = lines.collectEntries { id, recs -> [ (id): recs.count { line -> ((line.split('\t')[1] as int) & 0x900) != 0 } ] }
            def core = lines.collectEntries { id, recs -> [ (id): recs.collect { line -> line.split('\t').take(11).join('\t') }.sort().join('\n').md5() ] }
            assertAll(
                { assert process.success },
                { assert lines.keySet() == [ 'bam', 'embedded', 'expected' ] as Set },
                { assert lines.expected.size() > 0 : "primary_only.bam came out empty" },
                { assert flagged == [ bam: 0, embedded: 0, expected: 0 ] : "records with 0x900 left: ${flagged}" },
                { assert lines.bam.size() == lines.expected.size() : "BAM: ${lines.bam.size()} records, expected ${lines.expected.size()}" },
                { assert core.bam == core.expected : "BAM primary records differ from the test BAM's" },
                { assert core.embedded == core.expected : "embedded-reference CRAM decoded differently without a FASTA" }
            )
        }
    }

    test("CRAM without embedded reference, matching FASTA - decoded with it") {

        when {
            process {
                """
                input[0] = CRAM_FIXTURES.out.secondary_noref.map { _meta, f -> [ [ id:'noref' ], f, [] ] }
                    .mix(CRAM_FIXTURES.out.primary_only.map { _meta, f -> [ [ id:'expected' ], f, [] ] })
                input[1] = CRAM_FIXTURES.out.fasta.map { _meta, f -> [ [ id:'CHM13_chr19' ], f, [] ] }.first()
                input[2] = [ [:], [] ]
                input[3] = [ [:], [] ]
                input[4] = ''
                """
            }
        }

        then {
            def lines = process.out.bam.collectEntries { meta, out -> [ (meta.id): bam(out.toString(), stringency: 'silent').getSamLines() ] }
            def flagged = lines.collectEntries { id, recs -> [ (id): recs.count { line -> ((line.split('\t')[1] as int) & 0x900) != 0 } ] }
            def core = lines.collectEntries { id, recs -> [ (id): recs.collect { line -> line.split('\t').take(11).join('\t') }.sort().join('\n').md5() ] }
            assertAll(
                { assert process.success },
                { assert lines.keySet() == [ 'noref', 'expected' ] as Set },
                { assert lines.expected.size() > 0 : "primary_only.bam came out empty" },
                { assert flagged == [ noref: 0, expected: 0 ] : "records with 0x900 left: ${flagged}" },
                { assert core.noref == core.expected : "CRAM without embedded reference decoded differently with the matching FASTA" }
            )
        }
    }

    test("CRAM without embedded reference, FASTA of another assembly - fails in samtools") {

        when {
            process {
                """
                input[0] = CRAM_FIXTURES.out.secondary_noref.map { _meta, f -> [ [ id:'noref' ], f, [] ] }
                input[1] = CRAM_FIXTURES.out.other_fasta.map { _meta, f -> [ [ id:'GRCh38_chr19' ], f, [] ] }.first()
                input[2] = [ [:], [] ]
                input[3] = [ [:], [] ]
                input[4] = ''
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains('MD5 checksum reference mismatch') : process.errorReport }
            )
        }
    }

    test("CRAM without embedded reference, no FASTA and no reachable reference - fails in samtools") {

        // What the workflow does for a --fasta of another assembly: METAEXTRACT's M5 check withholds it

        when {
            process {
                """
                input[0] = CRAM_FIXTURES.out.secondary_noref.map { _meta, f -> [ [ id:'noref' ], f, [] ] }
                input[1] = [ [:], [], [] ]
                input[2] = [ [:], [] ]
                input[3] = [ [:], [] ]
                input[4] = ''
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains('Failed to populate reference') : process.errorReport }
            )
        }
    }
}
