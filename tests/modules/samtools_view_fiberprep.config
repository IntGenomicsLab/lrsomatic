process {
    // As SAMTOOLS_VIEW_FIBERPREP in conf/modules.config: primary records only, as BAM
    withName: 'SAMTOOLS_VIEW' {
        ext.args   = '--output-fmt bam,level=1 -F 0x900'
        ext.prefix = { "${meta.id}_primary" }
    }
}

// No reference server or cache: a CRAM that needs a reference must get it from the module's --reference
env {
    REF_PATH  = '/nonexistent/%2s/%2s/%s'
    REF_CACHE = '/nonexistent/%2s/%2s/%s'
}
