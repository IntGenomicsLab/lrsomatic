nextflow_pipeline {

    name "Test pipeline - --report_hmf_resource_dir reaches every sample's report as --hmf-* flags (-stub)"
    script "../main.nf"
    tag "pipeline"
    tag "small"

    // Launch checks are covered by utils_nfcore_lrsomatic_pipeline/tests/hmf_report.function.nf.test. The test
    // profiles set skip_report_hmf (no CI shard downloads the hosted bundle), so every test here opts back in.
    // The test profile is GRCh38, so the synthetic bundle (laid out like an oncoanalyser one) is staged; the
    // stub report records the flags the real run would pass. Bundle files without a slot are not staged.

    test("-profile test, synthetic HMF bundle - stub") {

        options "-stub"

        when {
            params {
                outdir                  = "$outputDir"
                skip_report_hmf         = false
                report_hmf_resource_dir = "${projectDir}/modules/local/lrsomaticreport/tests/hmf"
            }
        }

        then {
            def reports = file("$outputDir").listFiles().findAll { d -> d.isDirectory() }
                .collect { d -> file("${d}/report/${d.name}_report.html") }.findAll { f -> f.exists() }
            assertAll(
                { assert workflow.success },
                { assert reports.size() > 0 },
                { assert reports.every { f -> f.text.contains('--hmf-driver-panel "hmf/driver_panel/DriverGenePanel.38.tsv"') } },
                { assert reports.every { f -> f.text.contains('--hmf-ensembl-data-dir "hmf/ensembl/ensembl_data"') } },
                { assert reports.every { f -> f.text.contains('--hmf-known-fusions "hmf/known_fusions/known_fusion_data.38.csv"') } },
                { assert reports.every { f -> f.text.contains('--hmf-hotspots "hmf/hotspots/KnownHotspots.somatic.38.vcf.gz"') } },
                { assert reports.every { f -> f.text.contains('--hmf-actionable-bed "hmf/actionable_bed/ActionableCodingPanel.38.bed"') } }
            )
        }
    }

    // CHM13 with the GRCh38 bundle: HMF_LIFTOVER runs once, the reports get the lifted copy, which is published
    test("CHM13 chr19 input, synthetic HMF bundle lifted over - stub") {

        options "-stub"

        when {
            params {
                outdir                    = "$outputDir"
                input                     = "https://raw.githubusercontent.com/IntGenomicsLab/test-datasets/main/samplesheets/samplesheet_lr-somatic_chm13.csv"
                fasta                     = "https://raw.githubusercontent.com/IntGenomicsLab/test-datasets/main/references/CHM13V2_maskedY_rCRS_chr19.fa.gz"
                genome                    = "CHM13"
                skip_report_hmf           = false
                report_hmf_resource_dir   = "${projectDir}/modules/local/lrsomaticreport/tests/hmf"
                report_hmf_liftover_chain = "${projectDir}/modules/local/hmf_liftover/tests/fixtures/source_to_target.chain"
            }
        }

        then {
            def reports = file("$outputDir").listFiles().findAll { d -> d.isDirectory() }
                .collect { d -> file("${d}/report/${d.name}_report.html") }.findAll { f -> f.exists() }
            def lifts = workflow.trace.succeeded().findAll { task -> task.name.contains(':HMF_LIFTOVER') }
            assertAll(
                { assert workflow.success },
                { assert lifts.size() == 1 : "HMF_LIFTOVER tasks: ${lifts*.name}" },
                { assert reports.size() > 0 },
                // Same slot layout as on GRCh38, now staged from the lifted bundle
                { assert reports.every { f -> f.text.contains('--hmf-driver-panel "hmf/driver_panel/DriverGenePanel.38.tsv"') } },
                { assert reports.every { f -> f.text.contains('--hmf-ensembl-data-dir "hmf/ensembl/ensembl_data"') } },
                { assert reports.every { f -> f.text.contains('--hmf-hotspots "hmf/hotspots/KnownHotspots.somatic.38.vcf.gz"') } },
                { assert file("$outputDir/pipeline_info/hmf_liftover/hmf_chm13/common/ensembl_data/REFERENCE").text.trim() == 't2t' }
            )
        }
    }

    // No --report_hmf_*: the genome's hosted bundle (HMF_BUNDLE, a stub here, so nothing is downloaded); no liftover
    test("-profile test, hosted bundle by default - stub") {

        options "-stub"

        when {
            params {
                outdir          = "$outputDir"
                skip_report_hmf = false
            }
        }

        then {
            def reports = file("$outputDir").listFiles().findAll { d -> d.isDirectory() }
                .collect { d -> file("${d}/report/${d.name}_report.html") }.findAll { f -> f.exists() }
            def tasks = { proc -> workflow.trace.succeeded().findAll { task -> task.name.contains(":${proc}") } }
            assertAll(
                { assert workflow.success },
                { assert tasks.call('HMF_BUNDLE').size() == 1 },
                { assert tasks.call('HMF_LIFTOVER').size() == 0 },
                { assert reports.size() > 0 },
                { assert reports.every { f -> f.text.contains('--hmf-driver-panel "hmf/driver_panel/DriverGenePanel.38.tsv"') } },
                { assert reports.every { f -> f.text.contains('--hmf-ensembl-data-dir "hmf/ensembl/ensembl_data"') } },
                { assert reports.every { f -> f.text.contains('--hmf-actionable-bed "hmf/actionable_bed/ActionableCodingPanel.38.bed.gz"') } }
            )
        }
    }
}
