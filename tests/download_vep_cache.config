// The module stub ignores ext.args, so the task records its resolved args and inputs in .ext_record.
process {
    withName: '.*:ENSEMBLVEP_DOWNLOAD' {
        beforeScript = { 'echo ' + ['args=' + task.ext.args, 'species=' + species, 'assembly=' + assembly, 'cache_version=' + cache_version].join('\n').bytes.encodeBase64().toString() + ' | base64 -d > .ext_record' }
    }
}
