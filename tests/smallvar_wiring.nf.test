nextflow_pipeline {

    name "Test pipeline - small-variant filter and combine wiring with both callers per arm (-stub)"
    script "../main.nf"
    config "./smallvar_wiring.config"
    tag "pipeline"
    tag "small"

    // PR CI runs only `small` tests, and the one real run there (default) keeps the Clair callers only. The record-level
    // checks of the deep-caller paths (consensus, union, deep_only) are `extended`. These -stub runs put both callers in
    // each arm so every filter and combine step runs on every PR, and check what conf/modules.config resolved per task
    // (smallvar_wiring.config records it): the withName selectors of the DeepVariant/DeepSomatic filters (paired germline,
    // tumour-only germline and both somatic arms differ), which caller SMALL_VARIANT_CONSENSUS passes first, the fasta/fai
    // inputs of BCFTOOLS_CALLER_CONSENSUS and the DS_GERMLINE_SELECT knobs. The test samplesheet has two pairs (sample1,
    // sample2) and one tumour-only sample (sample3).

    test("-profile test, both callers, consensus, deep germline priority, smallvar_filter_pass=false - stub") {

        options "-stub"

        when {
            params {
                outdir                     = "$outputDir"
                germline_var_keep          = 'clair,deepvariant'
                somatic_var_keep           = 'clair,deepsomatic'
                germline_var_combine       = 'consensus'
                somatic_var_combine        = 'consensus'
                prioritize_caller_germline = 'deepvariant'
                prioritize_caller_somatic  = 'clair'
                smallvar_filter_pass       = false
            }
        }

        then {
            def work      = "$launchDir/work"
            def unfilter  = "-i 'GT=\"alt\" && (FILTER=\"PASS\" || FILTER=\"LowQual\")'"
            def pass_view = '--apply-filters PASS --output-type z --write-index=tbi'
            def paired    = ['sample1', 'sample2']
            def all       = ['sample1', 'sample2', 'sample3']
            def dv_paired = TaskRecord.of(work, 'PAIRED_SMALLVAR_GERMLINE:DEEPVARIANT_PASS_FILTER')
            def dv_to     = TaskRecord.of(work, 'TUMORONLY_SMALLVAR:DEEPVARIANT_PASS_FILTER')
            def ds        = TaskRecord.of(work, 'DEEPSOMATIC_PASS_FILTER')
            def germ      = TaskRecord.of(work, 'GERMLINE_CONSENSUS:BCFTOOLS_CALLER_CONSENSUS')
            def som       = TaskRecord.of(work, 'SOMATIC_CONSENSUS:BCFTOOLS_CALLER_CONSENSUS')
            def select    = TaskRecord.of(work, 'DS_GERMLINE_SELECT')
            assertAll(
                { assert workflow.success },
                // Paired germline DeepVariant: alt-genotype PASS/LowQual calls; tumour-only germline stays PASS-only
                { assert dv_paired.keySet() == paired as Set : "paired DEEPVARIANT_PASS_FILTER: ${dv_paired}" },
                { assert dv_paired.values().every { r -> r.args == unfilter + ' --output-type z --write-index=tbi' } : "${dv_paired}" },
                { assert dv_to.keySet() == ['sample3'] as Set : "tumour-only DEEPVARIANT_PASS_FILTER: ${dv_to}" },
                { assert dv_to.sample3.args == pass_view },
                // DeepSomatic, both arms: DEEPSOMATIC_FILTER adds the output options itself
                { assert ds.keySet() == all as Set : "DEEPSOMATIC_PASS_FILTER: ${ds}" },
                { assert ds.values().every { r -> r.args == unfilter } : "${ds}" },
                // The Clair PASS filters are off
                { assert TaskRecord.of(work, 'CLAIR3_PASS_FILTER').isEmpty() },
                { assert TaskRecord.of(work, 'CLAIRS_PASS_FILTER').isEmpty() },
                // Consensus, the priority caller's VCF first; the module's own defaults (no ext.args)
                { assert germ.keySet() == all as Set : "germline BCFTOOLS_CALLER_CONSENSUS: ${germ}" },
                { assert som.keySet() == all as Set : "somatic BCFTOOLS_CALLER_CONSENSUS: ${som}" },
                {
                    all.each { s ->
                        def clair_germ = s == 'sample3' ? 'clairs-to' : 'clair3'
                        def clair_som  = s == 'sample3' ? 'clairs-to' : 'clairs'
                        assert germ[s].subMap(['args', 'args2', 'prefix', 'prio', 'other']) ==
                            [args: 'null', args2: 'null', prefix: s + '_germline_sorted', prio: s + '.deepvariant.vcf.gz', other: s + '.' + clair_germ + '.vcf.gz'] : "${s}: ${germ[s]}"
                        assert som[s].subMap(['args', 'args2', 'prefix', 'prio', 'other']) ==
                            [args: 'null', args2: 'null', prefix: s + '_somatic_sorted', prio: s + '.' + clair_som + '.vcf.gz', other: s + '.deepsomatic.vcf.gz'] : "${s}: ${som[s]}"
                        [germ[s], som[s]].each { r ->
                            assert r.fai == r.fasta + '.fai' && !r.fasta.endsWith('.gz') : "${s}: fasta/fai ${r}"
                        }
                    }
                },
                { assert TaskRecord.of(work, 'BCFTOOLS_CALLER_UNION').isEmpty() },
                // Tumour-only germline: DeepVariant's PASS records with a GERMLINE/PON DeepSomatic verdict (raw DeepSomatic VCF)
                { assert select.keySet() == ['sample3'] as Set : "DS_GERMLINE_SELECT: ${select}" },
                {
                    def r = select.sample3
                    assert r.args == '' && r.args2 == "-i 'FILTER~\"GERMLINE\" || FILTER~\"PON\"'" : "${r}"
                    assert r.prefix == 'sample3.deepvariant_germline' && r.prio == 'sample3_deepvariant_pass.vcf.gz' : "${r}"
                    assert r.other == 'sample3_somatic.vcf.gz' : "the raw DeepSomatic VCF, not its filtered copy: ${r}"
                    assert r.fai == r.fasta + '.fai' : "${r}"
                }
            )
        }
    }

    test("-profile test, both callers, union ('all'), deep somatic priority, PASS filters on - stub") {

        options "-stub"

        when {
            params {
                outdir                     = "$outputDir"
                germline_var_keep          = 'clair,deepvariant'
                somatic_var_keep           = 'clair,deepsomatic'
                germline_var_combine       = 'all'
                somatic_var_combine        = 'all'
                prioritize_caller_germline = 'clair'
                prioritize_caller_somatic  = 'deepsomatic'
            }
        }

        then {
            def work      = "$launchDir/work"
            def pass_view = '--apply-filters PASS --output-type z --write-index=tbi'
            def paired    = ['sample1', 'sample2']
            def all       = ['sample1', 'sample2', 'sample3']
            def dv_paired = TaskRecord.of(work, 'PAIRED_SMALLVAR_GERMLINE:DEEPVARIANT_PASS_FILTER')
            def dv_to     = TaskRecord.of(work, 'TUMORONLY_SMALLVAR:DEEPVARIANT_PASS_FILTER')
            def ds        = TaskRecord.of(work, 'DEEPSOMATIC_PASS_FILTER')
            def clair3    = TaskRecord.of(work, 'CLAIR3_PASS_FILTER')
            def clairs    = TaskRecord.of(work, 'CLAIRS_PASS_FILTER')
            def germ      = TaskRecord.of(work, 'GERMLINE_CONSENSUS:BCFTOOLS_CALLER_UNION')
            def som       = TaskRecord.of(work, 'SOMATIC_CONSENSUS:BCFTOOLS_CALLER_UNION')
            assertAll(
                { assert workflow.success },
                { assert dv_paired.keySet() == paired as Set && dv_paired.values().every { r -> r.args == pass_view } : "paired DEEPVARIANT_PASS_FILTER: ${dv_paired}" },
                { assert dv_to.keySet() == ['sample3'] as Set && dv_to.sample3.args == pass_view : "tumour-only DEEPVARIANT_PASS_FILTER: ${dv_to}" },
                { assert ds.keySet() == all as Set && ds.values().every { r -> r.args == '--apply-filters PASS' } : "DEEPSOMATIC_PASS_FILTER: ${ds}" },
                { assert clair3.keySet() == paired as Set && clair3.values().every { r -> r.args == pass_view } : "CLAIR3_PASS_FILTER: ${clair3}" },
                { assert clairs.keySet() == paired as Set && clairs.values().every { r -> r.args == pass_view } : "CLAIRS_PASS_FILTER: ${clairs}" },
                // Union, the priority caller's VCF first
                { assert germ.keySet() == all as Set : "germline BCFTOOLS_CALLER_UNION: ${germ}" },
                { assert som.keySet() == all as Set : "somatic BCFTOOLS_CALLER_UNION: ${som}" },
                {
                    all.each { s ->
                        def clair_germ = s == 'sample3' ? 'clairs-to' : 'clair3'
                        def clair_som  = s == 'sample3' ? 'clairs-to' : 'clairs'
                        assert germ[s].subMap(['prefix', 'prio', 'other']) ==
                            [prefix: s + '_germline_sorted', prio: s + '.' + clair_germ + '.vcf.gz', other: s + '.deepvariant.vcf.gz'] : "${s}: ${germ[s]}"
                        assert som[s].subMap(['prefix', 'prio', 'other']) ==
                            [prefix: s + '_somatic_sorted', prio: s + '.deepsomatic.vcf.gz', other: s + '.' + clair_som + '.vcf.gz'] : "${s}: ${som[s]}"
                    }
                },
                { assert TaskRecord.of(work, 'BCFTOOLS_CALLER_CONSENSUS').isEmpty() },
                { assert TaskRecord.of(work, 'DS_GERMLINE_SELECT').keySet() == ['sample3'] as Set }
            )
        }
    }
}
