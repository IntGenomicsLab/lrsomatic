nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"
    tag "small"

    test("-profile test") {

        when {
            params {
                outdir = "$outputDir"
                // A builtin plus a panel file, covering the comma-separated form end to end
                report_gene_panel = "lymphoid,$projectDir/modules/local/lrsomaticreport/tests/test_panel.tsv"
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success},

                // ── Phased VCFs: records present, all PASS, somatic arm tagged ──
                { PhasedVcf.assertPassOnly("$outputDir", ['sample1', 'sample2', 'sample3'], ['sample3']) },
                { PhasedVcf.assertOnePerPosition("$outputDir", ['sample1', 'sample2', 'sample3']) },
                { //files exist
                    assert file("$launchDir/output/sample1/variants/clair3/merge_output.vcf.gz").exists()
                    assert file("$launchDir/output/sample1/variants/clair3/merge_output.vcf.gz.tbi").exists()
                    assert file("$launchDir/output/sample1/variants/clairs/indel.vcf.gz").exists()
                    assert file("$launchDir/output/sample1/variants/clairs/indel.vcf.gz.tbi").exists()
                    assert file("$launchDir/output/sample1/variants/clairs/snvs.vcf.gz").exists()
                    assert file("$launchDir/output/sample1/variants/clairs/snvs.vcf.gz.tbi").exists()
                    assert file("$launchDir/output/sample1/variants/severus/somatic_SVs/severus_somatic.vcf.gz").exists()
                    assert file("$launchDir/output/sample1/variants/savana/sample1.classified.somatic.vcf").exists()
                    assert file("$launchDir/output/sample2/variants/clair3/merge_output.vcf.gz").exists()
                    assert file("$launchDir/output/sample2/variants/clair3/merge_output.vcf.gz.tbi").exists()
                    assert file("$launchDir/output/sample2/variants/clairs/indel.vcf.gz").exists()
                    assert file("$launchDir/output/sample2/variants/clairs/indel.vcf.gz.tbi").exists()
                    assert file("$launchDir/output/sample2/variants/clairs/snvs.vcf.gz").exists()
                    assert file("$launchDir/output/sample2/variants/clairs/snvs.vcf.gz.tbi").exists()
                    assert file("$launchDir/output/sample2/variants/severus/somatic_SVs/severus_somatic.vcf.gz").exists()
                    assert file("$launchDir/output/sample2/variants/savana/sample2.classified.somatic.vcf").exists()
                    assert file("$launchDir/output/sample1/bamfiles/sample1_normal.cram").exists()
                    assert file("$launchDir/output/sample1/bamfiles/sample1_tumor.cram").exists()
                    assert file("$launchDir/output/sample1/bamfiles/sample1_normal.cram.crai").exists()
                    assert file("$launchDir/output/sample1/bamfiles/sample1_tumor.cram.crai").exists()
                    assert file("$launchDir/output/sample3/variants/clairsto/indel.vcf.gz").exists()
                    assert file("$launchDir/output/sample3/variants/clairsto/snv.vcf.gz").exists()
                    assert file("$launchDir/output/sample3/variants/clairsto/somatic.vcf.gz").exists()
                    assert file("$launchDir/output/sample3/variants/clairsto/germline.vcf.gz").exists()
                },
                { // both panels named in --report_gene_panel are ticked on load
                    def report = file("$launchDir/output/sample1/report/sample1_report.html")
                    assert report.exists()
                    def matcher = (report.text =~ /const DEFAULT_PANELS = (\[[^\]]*\])/)
                    assert matcher.find()
                    assert matcher.group(1).contains("lymphoid")
                    assert matcher.group(1).contains("test_panel")
                },
                { // Read groups: CRAM keeps one RG per record, so each must be declared in the header. The H2009
                  // uBAM (sample1 tumour, sample3) carries dorado's RG on every record; without `samtools reset -x RG`
                  // in MINIMAP2_ALIGN that undeclared RG wins and only this fails (CRAM md5s are not snapshotted)
                    ['sample1_normal', 'sample1_tumor', 'sample2_normal', 'sample2_tumor', 'sample3_tumor'].each { name ->
                        def s = name.tokenize('_')[0]
                        def reader = htsjdk.samtools.SamReaderFactory.makeDefault()
                            .validationStringency(htsjdk.samtools.ValidationStringency.SILENT)
                            .open(new File("$launchDir/output/${s}/bamfiles/${name}.cram"))
                        def ids = reader.getFileHeader().getReadGroups()*.getId() as Set
                        def undeclared = reader.iterator().findAll { !(it.getAttribute('RG') in ids) }.size()
                        reader.close()
                        assert undeclared == 0 : "${name}.cram: ${undeclared} records carry an RG missing from the header ${ids}"
                    }
                },
                { // The meta workflows/lrsomatic.nf sets for MINIMAP2_ALIGN, as rendered by conf/modules.config. Every row
                  // is an aligned BAM, so each samtools reset drops the old alignment's tags (aligned_input), PacBio rows
                  // also the kinetics, and the ONT inputs, whose headers name a Dorado model, get it in the new @RG
                  // (basecall_model). What this does to the reads: tests/modules/minimap2_align_tags.nf.test
                    def aligned = 'RG,HP,PS,PQ,PC,tp,cm,s1,s2,nn,ms,de,dv,rl,zd,cs,cg,ds,OA,XA,XS'
                    def model = 'DS:basecall_model=dna_r10.4.1_e8.2_400bps_sup@v5.0.0'
                    def expected = [
                        sample1_normal_rep1: [ reset: aligned, ds: model ],
                        sample1_tumor_rep1:  [ reset: aligned, ds: model ],
                        sample2_normal_rep1: [ reset: aligned + ',fi,fp,ri,rp,ip,pw', ds: null ],
                        sample2_tumor_rep1:  [ reset: aligned + ',fi,fp,ri,rp,ip,pw', ds: null ],
                        sample3_tumor_rep1:  [ reset: aligned, ds: model ]
                    ]
                    def rendered = (new File("$launchDir/work").listFiles() ?: [])
                        .collectMany { dir -> (dir.listFiles() ?: []) as List }
                        .collect { dir -> new File(dir, '.command.sh') }
                        .findAll { script -> script.exists() && script.text.contains('samtools reset') && script.text.contains('minimap2') }
                        .collectEntries { script ->
                            def rg = (script.text =~ /-R '([^']*)'/)[0][1].split(/\\t/) as List
                            [ (rg.find { field -> field.startsWith('ID:') }.substring(3)):
                                [ reset: (script.text =~ /samtools reset .*?-x (\S+)/)[0][1],
                                  ds: rg.find { field -> field.startsWith('DS:') } ] ]
                        }
                    assert rendered == expected
                    // ...and the model survives into the published files
                    ['sample1_normal', 'sample1_tumor', 'sample2_normal', 'sample2_tumor', 'sample3_tumor'].each { name ->
                        def s = name.tokenize('_')[0]
                        def reader = htsjdk.samtools.SamReaderFactory.makeDefault()
                            .validationStringency(htsjdk.samtools.ValidationStringency.SILENT)
                            .open(new File("$launchDir/output/${s}/bamfiles/${name}.cram"))
                        def ds = reader.getFileHeader().getReadGroups()*.getDescription()
                        reader.close()
                        assert ds == [ s == 'sample2' ? null : model.substring(3) ] : "${name}.cram read group DS: ${ds}"
                    }
                },
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/lrsomatic_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path
                ).match() }
            )
        }
    }
}
