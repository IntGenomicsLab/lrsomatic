/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests against the CHM13 reference genome
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Same scope as the `test` profile (same 3 samples, same skipped steps), but the samples
    are aligned to CHM13 chr19 instead of GRCh38 chr19 and --genome CHM13 is set, so every
    genome-conditional code path (ClairSTO/DeepSomatic PON selection, Severus PON/bed,
    SAVANA) exercises its CHM13 branch instead of its GRCh38 branch.

    Use as follows:
        nextflow run IntGenomicsLab/lrsomatic -profile test_chm13,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    withName: '.*' {
        resourceLimits = [
            cpus: 4,
            memory: '15.GB',
            time: '1.h'
        ]
    }

    withName: '.*DEEPVARIANT_MAKEEXAMPLES' {
        ext.args = {
           "--regions 'chr19'"
        }
    }

    withName: '.*DEEPVARIANT_POSTPROCESSVARIANTS' {
        ext.args = {
            "--regions 'chr19'"
        }
    }
    withName: '.*DEEPSOMATIC_MAKEEXAMPLES' {
       ext.args = {
            "--regions 'chr19'"
       }
    }
    withName: '.*DEEPSOMATIC_POSTPROCESSVARIANTS' {
       ext.args = {
            "--regions 'chr19'"
       }
    }
    // SAVANA's cellularity-fitting step (savana cna, run standalone or internally by savana to)
    // can raise an unhandled StatisticsError on minimal smoke-test data -- too few real
    // heterozygous SNPs for the allele-count-based estimator. The vendored nf-core module's own
    // test suite already marks this exact output optional for the same reason (see
    // modules/nf-core/savana/cna/main.nf's "not possible with test data" comments). Ignoring
    // failures here only in the test profile keeps the rest of the pipeline (and the CI
    // assertions, which don't depend on CNA's output) green; it does not affect real runs.
    withName: '.*SAVANA_CNA' {
       ext.args = {
            "--chromosomes 19"
       }
       errorStrategy = 'ignore'
    }
    withName: '.*SAVANA_TO' {
       ext.args = {
            "--chromosomes 19"
       }
       errorStrategy = 'ignore'
    }

}

params {
    config_profile_name        = 'CHM13 test profile'
    config_profile_description = 'Minimal test dataset (CHM13 chr19) to check pipeline function against the CHM13 reference genome'

    // Input data -- same 3 samples as the `test` profile, realigned to CHM13 chr19
    input    = "https://raw.githubusercontent.com/IntGenomicsLab/test-datasets/main/samplesheets/samplesheet_lr-somatic_chm13.csv"
    fasta    = "https://raw.githubusercontent.com/IntGenomicsLab/test-datasets/main/references/CHM13V2_maskedY_rCRS_chr19.fa.gz"

    // Additional params
    genome             = "CHM13"
    vep_genome         = "WBcel235"
    vep_species        = "caenorhabditis_elegans"
    skip_wakhan        = true
    skip_ascat         = true
    skip_modkit        = true

}
