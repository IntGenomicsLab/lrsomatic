/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    IntGenomicsLab/lrsomatic Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

process {

    cpus   = { 1      * task.attempt }
    memory = { 6.GB   * task.attempt }
    time   = { 4.h    * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // Process-specific resource requirements
    // NOTE - Please try and reuse the labels below as much as possible.
    //        These labels are used and recognised by default in DSL2 files hosted on nf-core/modules.
    //        If possible, it would be nice to keep the same label naming convention when
    //        adding in your local modules too.
    // See https://www.nextflow.io/docs/latest/config.html#config-process-selectors
    withLabel:process_gpu_high {
        accelerator = { (params.use_gpu as boolean) ? 1 : null }
        cpus   = { 8      * task.attempt }
        memory = { 48.GB  * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_gpu_very_high {
        accelerator = { (params.use_gpu as boolean) ? 1 : null }
        cpus   = { 16     * task.attempt }
        memory = { 96.GB  * task.attempt }
        time   = { 10.h   * task.attempt }
    }
    withLabel:process_gpu_very_high_memory {
        accelerator = { (params.use_gpu as boolean) ? 1 : null }
        cpus   = { 16     * task.attempt }
        memory = { 128.GB * task.attempt }
    }
    withLabel:process_single {
        cpus   = { 1                   }
        memory = { 6.GB   * task.attempt }
        time   = { 4.h    * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2      * task.attempt }
        memory = { 12.GB  * task.attempt }
        time   = { 4.h    * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 6      * task.attempt }
        memory = { 36.GB  * task.attempt }
        time   = { 8.h    * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 12     * task.attempt }
        memory = { 72.GB  * task.attempt }
        time   = { 16.h   * task.attempt }
    }
    withLabel:process_very_high {
        cpus   = { 24     * task.attempt }
        memory = { 144.GB * task.attempt }
        time   = { 16.h   * task.attempt }
    }
    withLabel:process_long {
        time   = { 24.h   * task.attempt }
    }
    withLabel:process_low_memory {
        memory = { 1.GB * task.attempt }
    }
    withLabel:process_high_memory {
        memory = { 200.GB * task.attempt }
    }
    withLabel:process_short {
        time   = { 1.h }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withLabel: process_gpu {
        accelerator = { workflow.profile.contains('gpu') ? 1 : null }
    }

    // Process-specific requests sized from execution traces of ~30x whole-genome runs (ONT and PacBio,
    // matched pairs and tumour-only, GRCh38 and CHM13; see docs/usage.md#resource-requests). They sit here
    // rather than in conf/modules.config so that they read as resource defaults, and they use withName
    // because the processes are nf-core modules (labels not edited here) or no shared label fits.
    // Each keeps attempt scaling, so a retry after a resource kill doubles the request.

    // fibertools-rs: peak RSS <= 3.1 GB on every input (process_high_memory gives 200 GB, QC 144 GB);
    // nucleosomes and qc use 5-8 cpus whatever -t says, FIRE up to 22 of 24 on PacBio
    withName: '.*:FIBERTOOLSRS_NUCLEOSOMES' {
        cpus   = { 8     * task.attempt }
        memory = { 8.GB  * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withName: '.*:FIBERTOOLSRS_FIRE' {
        cpus   = { 16    * task.attempt }
        memory = { 8.GB  * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withName: '.*:FIBERTOOLSRS_QC' {
        cpus   = { 8     * task.attempt }
        memory = { 8.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    // m6A prediction on 326-343 GB kinetics uBAMs (~30x Revio): 3.9 h at ~48 busy cpus, 7.0 GB peak.
    // ~185 cpu-hours per sample, so ~6-8 h at 32 cpus; 24 h leaves room for deeper samples
    withName: '.*:FIBERTOOLSRS_PREDICTM6A' {
        cpus   = { 32    * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 24.h  * task.attempt }
    }

    // VEP (--fork task.cpus): germline annotation keeps ~15 forks busy for 11-25 min at <= 3.3 GB;
    // somatic and SV annotation finish in <= 3 min at <= 18.4 GB peak RSS (summed over 24 forks)
    withName: '.*:GERMLINE_VEP' {
        cpus   = { 16    * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withName: '.*:(SOMATIC_VEP|SV_VEP|VEP_SAVANA)' {
        cpus   = { 6     * task.attempt }
        memory = { 24.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    // Per-sample bcftools steps of the consensus, Verdict and phasing chains (process_medium): <= 75 s, <= 0.7 GB
    withName: '.*:(BCFTOOLS_(CONCAT|SORT|VIEW|NORM|ISEC|NORM_REJOIN|SORT_CONSENSUS)|SORT_POST_NORM|SORT_SOMATIC_PHASED|CONCAT_SOMATIC_UNPHASED|REJOIN_(GERMLINE|SOMATIC)|SOMATIC_(ALT|NONALT)|(CLAIR3|CLAIRS|DEEPVARIANT|DEEPSOMATIC)_PASS_FILTER|SIGNATURES_BCFTOOLS_VIEW|DS_(GERMLINE_REJOIN|GERMLINE_SELECT|VERDICT_SITES|VERDICT_SPLIT_DS|VERDICT_SPLIT_DV))' {
        cpus   = { 2     * task.attempt }
        memory = { 4.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    // The module runs `longphase modcall --threads 1` (1.2-1.4 cpus busy); 30x ONT peaks at 43.9 GB in <= 1.3 h
    withName: '.*:LONGPHASE_MODCALL_.*' {
        cpus   = { 2     * task.attempt }
        memory = { 64.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    // R/Quarto, single-threaded: <= 3 min, peak RSS <= 18.2 GB
    withName: '.*:LRSOMATICREPORT' {
        cpus   = { 1                    }
        memory = { 32.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    // <= 2 min, <= 2.8 GB, 2-4 cpus busy
    withName: '.*:MOSDEPTH' {
        cpus   = { 4     * task.attempt }
        memory = { 8.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    // cramino decompresses with 4 threads by default (3.3-4.0 cpus busy against process_low's 2)
    withName: '.*:CRAMINO_(PRE|POST)' {
        cpus   = { 4                    }
    }

    // Peaks close to or above the label's memory on 30x data (process_medium 36 GB, process_high 72 GB).
    // SAVANA and Wakhan run multiprocessing pools, so their peak RSS sums worker pages shared after fork()
    // and overstates what the cgroup charges; they are raised anyway because a pool that loses a worker to
    // the OOM killer can wait forever instead of failing (as DeepVariant's postprocess does)
    withName: '.*:SEVERUS' {
        memory = { 64.GB * task.attempt }
    }
    withName: '.*:WAKHAN' {
        memory = { 72.GB * task.attempt }
    }
    withName: '.*:SAVANA_(RUN|TO)' {
        memory = { 96.GB * task.attempt }
    }

    // CPU inference holds <= 14.5 GB at 48 cpus; process_very_high's 144 GB only widens the job on
    // clusters that cap memory per core. The GPU labels' memory is kept under --use_gpu
    withName: '.*:DEEPSOMATIC_CALLVARIANTS' {
        memory = { 48.GB * task.attempt }
    }
    withName: '.*:DEEPVARIANT_CALLVARIANTS' {
        memory = { ((params.use_gpu as boolean) ? 96.GB : 48.GB) * task.attempt }
    }
}
