/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    IntGenomicsLab/lrsomatic Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

process {

    cpus   = { 1      * task.attempt }
    memory = { 6.GB   * task.attempt }
    time   = { 4.h    * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177) + Integer.MAX_VALUE) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // Process-specific resource requirements
    // NOTE - Please try and reuse the labels below as much as possible.
    //        These labels are used and recognised by default in DSL2 files hosted on nf-core/modules.
    //        If possible, it would be nice to keep the same label naming convention when
    //        adding in your local modules too.
    // See https://www.nextflow.io/docs/latest/config.html#config-process-selectors
    withLabel:process_gpu_high {
        accelerator = { (params.use_gpu as boolean) ? 1 : null }
        cpus   = { 8      * task.attempt }
        memory = { 48.GB  * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_gpu_very_high {
        accelerator = { (params.use_gpu as boolean) ? 1 : null }
        cpus   = { 16     * task.attempt }
        memory = { 96.GB  * task.attempt }
        time   = { 10.h   * task.attempt }
    }
    withLabel:process_gpu_very_high_memory {
        accelerator = { (params.use_gpu as boolean) ? 1 : null }
        cpus   = { 16     * task.attempt }
        memory = { 128.GB * task.attempt }
    }
    withLabel:process_single {
        cpus   = { 1                   }
        memory = { 6.GB   * task.attempt }
        time   = { 4.h    * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2      * task.attempt }
        memory = { 12.GB  * task.attempt }
        time   = { 4.h    * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 6      * task.attempt }
        memory = { 36.GB  * task.attempt }
        time   = { 8.h    * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 12     * task.attempt }
        memory = { 72.GB  * task.attempt }
        time   = { 16.h   * task.attempt }
    }
    withLabel:process_very_high {
        cpus   = { 24     * task.attempt }
        memory = { 144.GB * task.attempt }
        time   = { 16.h   * task.attempt }
    }
    withLabel:process_long {
        time   = { 24.h   * task.attempt }
    }
    withLabel:process_low_memory {
        memory = { 1.GB * task.attempt }
    }
    withLabel:process_high_memory {
        memory = { 200.GB * task.attempt }
    }
    withLabel:process_short {
        time   = { 1.h }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withLabel: process_gpu {
        accelerator = { workflow.profile.contains('gpu') ? 1 : null }
    }

    // Sized from ~30x whole-genome traces (docs/usage.md#measured-needs-at-30x)

    // A task that requests a GPU keeps the GPU label's 24 cpus / 144 GB / 16 h (that path was never measured)
    withName: '.*:FIBERTOOLSRS_NUCLEOSOMES' {
        cpus   = { (task.accelerator ? 24     : 8)    * task.attempt }
        memory = { (task.accelerator ? 144.GB : 8.GB) * task.attempt }
        time   = { (task.accelerator ? 16.h   : 8.h)  * task.attempt }
    }
    withName: '.*:FIBERTOOLSRS_FIRE' {
        cpus   = { (task.accelerator ? 24     : 16)   * task.attempt }
        memory = { (task.accelerator ? 144.GB : 8.GB) * task.attempt }
        time   = { (task.accelerator ? 16.h   : 8.h)  * task.attempt }
    }
    withName: '.*:FIBERTOOLSRS_QC' {
        cpus   = { 8     * task.attempt }
        memory = { 8.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withName: '.*:FIBERTOOLSRS_PREDICTM6A' {
        cpus   = { (task.accelerator ? 24     : 48)    * task.attempt }
        memory = { (task.accelerator ? 144.GB : 16.GB) * task.attempt }
        time   = { (task.accelerator ? 16.h   : 24.h)  * task.attempt }
    }

    withName: '.*:GERMLINE_VEP' {
        cpus   = { 16    * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withName: '.*:(SOMATIC_VEP|SV_VEP|VEP_SAVANA)' {
        cpus   = { 6     * task.attempt }
        memory = { 24.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withName: '.*:(BCFTOOLS_(CONCAT|SORT|VIEW|NORM|CALLER_CONSENSUS)|SORT_POST_NORM|REJOIN_GERMLINE|(CLAIR3|CLAIRS|DEEPVARIANT|DEEPSOMATIC)_PASS_FILTER|SIGNATURES_BCFTOOLS_VIEW|DS_GERMLINE_SELECT)' {
        cpus   = { 2     * task.attempt }
        memory = { 4.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    // The module runs `longphase modcall --threads 1`, so extra cpus would sit idle
    withName: '.*:LONGPHASE_MODCALL_.*' {
        cpus   = { 2     * task.attempt }
        memory = { 64.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    withName: '.*:LRSOMATICREPORT' {
        cpus   = { 1                    }
        memory = { 16.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withName: '.*:MOSDEPTH' {
        cpus   = { 4     * task.attempt }
        memory = { 8.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    // cramino decompresses with 4 threads by default
    withName: '.*:CRAMINO_(PRE|POST)' {
        cpus   = { 4                    }
    }

    // SAVANA/Wakhan peak RSS overstates use, but a pool that loses a worker to OOM can hang, not fail
    withName: '.*:SEVERUS' {
        memory = { 64.GB * task.attempt }
    }
    withName: '.*:WAKHAN' {
        memory = { 72.GB * task.attempt }
    }
    withName: '.*:SAVANA_RUN' {
        memory = { 128.GB * task.attempt }
    }
    withName: '.*:SAVANA_TO' {
        memory = { 96.GB  * task.attempt }
    }

    // 48 cpus on the long callers halve their wall time at ~30x (2026-11 campaigns)
    withName: '.*:CLAIRS' {
        cpus   = { 48     * task.attempt }
    }
    withName: '.*:DEEPSOMATIC_MAKEEXAMPLES' {
        cpus   = { 48     * task.attempt }
        memory = { 192.GB * task.attempt }
    }
    withName: '.*:DEEPSOMATIC_CALLVARIANTS' {
        cpus   = { (task.accelerator ? 8 : 48) * task.attempt }
        memory = { 48.GB * task.attempt }
    }
    withName: '.*:DEEPVARIANT_CALLVARIANTS' {
        memory = { ((params.use_gpu as boolean) ? 96.GB : 48.GB) * task.attempt }
    }
}
