nextflow_process {

    name "Test Process PHASE_SOMATIC_FROM_READS"
    script "../main.nf"
    process "PHASE_SOMATIC_FROM_READS"

    tag "modules"
    tag "modules_local"
    tag "phase_somatic_from_reads"
    tag "small"

    // fixtures.nf: HP1 reads r1-r4, HP2 reads r5-r8 (all PS 1001), untagged reads r9-r12. Expected per record:
    //   POS  record        alt reads (HP1,HP2,untagged)  GT    why
    //   50   SNV           4,0,0                         1|0
    //   70   SNV           0,4,0                         0|1
    //   90   SNV           2,0,0                         0/1   fewer than 3 tagged alt reads
    //   110  SNV           3,2,0                         0/1   3/5 < 0.8 on one haplotype
    //   130  SNV           0,0,4                         0/1   no tagged alt reads
    //   150  2 bp deletion 4,0,0                         1|0
    //   200  TT insertion  0,4,0                         0|1
    //   230  SNV           4,0,0                         1|0   SNV and insertion at one POS, each phased alone
    //   230  GG insertion  0,4,0                         0|1
    //   250  SNV, 1/1      4,4,4                         1/1   not heterozygous
    //   270  0/0           -                             0/0   no ALT in GT: no AHP
    def expected = [
        '50:A'  : ['1|0', '1001', '4,0,0'],
        '70:A'  : ['0|1', '1001', '0,4,0'],
        '90:A'  : ['0/1', null,   '2,0,0'],
        '110:A' : ['0/1', null,   '3,2,0'],
        '130:A' : ['0/1', null,   '0,0,4'],
        '150:D' : ['1|0', '1001', '4,0,0'],
        '200:I' : ['0|1', '1001', '0,4,0'],
        '230:A' : ['1|0', '1001', '4,0,0'],
        '230:I' : ['0|1', '1001', '0,4,0'],
        '250:A' : ['1/1', null,   '4,4,4'],
        '270:A' : ['0/0', null,   null   ],
    ]

    // [GT, PS, AHP] per record, keyed POS:kind (A = SNV, D = deletion, I = insertion); '.' and absent fields as null
    def calls = { String vcf ->
        new java.util.zip.GZIPInputStream(new FileInputStream(vcf)).withReader { reader ->
            reader.readLines().findAll { line -> !line.startsWith('#') }.collectEntries { line ->
                def f      = line.split('\t')
                def kind   = f[3].size() > f[4].size() ? 'D' : f[3].size() < f[4].size() ? 'I' : 'A'
                def keys   = f[8].split(':').toList()
                def values = f[9].split(':').toList()
                def value  = { String key ->
                    def i = keys.indexOf(key)
                    (i >= 0 && i < values.size() && values[i] != '.') ? values[i] : null
                }
                [ ("${f[1]}:${kind}".toString()) : [ value('GT'), value('PS'), value('AHP') ] ]
            }
        }
    }

    setup {
        run("PSFR_FIXTURE") {
            script "./fixtures.nf"
            process { "input[0] = [ id:'fixture' ]" }
        }
    }

    test("BAM - phases from alt-read haplotags, leaves the rest unphased") {

        when {
            process {
                """
                input[0] = PSFR_FIXTURE.out.vcf.join(PSFR_FIXTURE.out.bam)
                input[1] = PSFR_FIXTURE.out.fasta.map { _meta, fasta -> [ [:], fasta ] }
                input[2] = PSFR_FIXTURE.out.fai.map { _meta, fai -> [ [:], fai ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert calls(process.out.vcf[0][1].toString()) == expected },
                { assert file(process.out.tbi[0][1]).exists() },
                { assert snapshot(process.out.findAll { key, _val -> key.startsWith('versions') }).match() }
            )
        }
    }

    test("CRAM - same calls as BAM") {

        when {
            process {
                """
                input[0] = PSFR_FIXTURE.out.vcf.join(PSFR_FIXTURE.out.cram)
                input[1] = PSFR_FIXTURE.out.fasta.map { _meta, fasta -> [ [:], fasta ] }
                input[2] = PSFR_FIXTURE.out.fai.map { _meta, fai -> [ [:], fai ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert calls(process.out.vcf[0][1].toString()) == expected }
            )
        }
    }

    test("stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = PSFR_FIXTURE.out.vcf.join(PSFR_FIXTURE.out.bam)
                input[1] = PSFR_FIXTURE.out.fasta.map { _meta, fasta -> [ [:], fasta ] }
                input[2] = PSFR_FIXTURE.out.fai.map { _meta, fai -> [ [:], fai ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
