nextflow_process {

    name "Test Process PADFOOT"
    script "../main.nf"
    process "PADFOOT"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "padfoot"
    // "small" is what .github/workflows/nf-test.yml selects on for pull_request
    tag "small"

    // The stub tests check the I/O contract. The "real" tests run Padfoot itself on the synthetic Severus/Wakhan/SAVANA
    // fixtures in tests/fixtures/padfoot_reconplot (invented events on a 2 Mb slice of GRCh38 chr19: a deletion over STK11
    // exons with a matching one-copy loss, a tandem duplication with a matching gain, a templated and an Alu insertion,
    // two breakend pairs), so the command line, the parsers, minimap2/samtools and RepeatMasker are exercised in CI.

    test("severus + wakhan - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', paired_data:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/vcf/test.rnaseq.vcf', checkIfExists: true),
                    'severus',
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gvcf/test.genome.vcf', checkIfExists: true),
                    'wakhan',
                    []
                ]
                input[1] = [ [ id:'ref' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true) ]
                input[2] = [ [ id:'ref' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true) ]
                input[3] = [ [:], 'hg38', [], [] ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("savana + savana - tumour only - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', paired_data:null ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/vcf/test.rnaseq.vcf', checkIfExists: true),
                    'savana',
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.bed', checkIfExists: true),
                    'savana',
                    []
                ]
                input[1] = [ [ id:'ref' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true) ]
                input[2] = [ [ id:'ref' ], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true) ]
                input[3] = [ [:], 'hg38', [], [] ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("severus + wakhan - real, RepeatMasker on") {

        config "./nextflow.repeatmasker.config"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', paired_data:'test' ],
                    file("${projectDir}/tests/fixtures/padfoot_reconplot/severus_somatic.vcf.gz", checkIfExists: true),
                    'severus',
                    file("${projectDir}/tests/fixtures/padfoot_reconplot/wakhan/solution_rank_1/integer_profile.vcf", checkIfExists: true),
                    'wakhan',
                    file("${projectDir}/tests/fixtures/padfoot_reconplot/wakhan/solutions_ranks.tsv", checkIfExists: true)
                ]
                input[1] = [ [ id:'ref' ], file("${projectDir}/tests/fixtures/padfoot_reconplot/chr19_1-2Mb.fasta", checkIfExists: true) ]
                input[2] = [ [ id:'ref' ], file("${projectDir}/tests/fixtures/padfoot_reconplot/chr19_1-2Mb.fasta.fai", checkIfExists: true) ]
                input[3] = [ [:], 'hg38', [], [] ]
                """
            }
        }

        then {
            def svs = path(process.out.annotated_svs.get(0).get(1)).readLines()
            def svs_by_id = svs.drop(1).collectEntries { line -> def f = line.split('\t', -1); [(f[0]): f] }
            assertAll(
                { assert process.success },
                // every fixture SV annotated once; breakend pairs collapse to their _1 record
                { assert svs_by_id.keySet() == ['severus_BND1_1', 'severus_BND2_1', 'severus_INS1', 'severus_INS2', 'severus_DEL1', 'severus_DUP1'] as Set },
                // the STK11 exon deletion is the high-impact TSG hit; the Alu insertion sits in an ABCA7 intron and maps back to its source
                { assert svs_by_id['severus_DEL1'][9] == 'HIGH_ONCO' && svs_by_id['severus_DEL1'][11] == 'STK11' },
                // both ends in STK11 (intron 3 -> exon 10): an exon-removing event, not an annotation of one breakend only
                { assert svs_by_id['severus_DEL1'][20] == 'between_exons' && svs_by_id['severus_DEL1'][12] == 'intron3' && svs_by_id['severus_DEL1'][17] == 'exon10' },
                // SBNO2 is on the minus strand, so the templated insertion lies in its 3' flank
                { assert svs_by_id['severus_INS1'][11] == 'SBNO2' && svs_by_id['severus_INS1'][12] == 'downstream' },
                { assert svs_by_id['severus_INS2'][11] == 'ABCA7' && svs_by_id['severus_INS2'][24].startsWith('chr19:') },
                // RepeatMasker classified the Alu copy (Padfoot >= 25fd6d4 keeps the last query's hits; the masked length it
                // reports is end - begin, i.e. 299 for the 300 bp copy -- an upstream off-by-one, so only the class is asserted)
                { assert svs_by_id['severus_INS2'][25].startsWith('SINE/Alu:') },
                // by_gene: Padfoot reads a gene's copy number at its start, labelled against the fitted ploidy (2.0 -> 1 per
                // haplotype); STK11 starts before the internal loss, so its CN is NEUT, and the exon-removing deletion is
                // reported in its SV columns (unphased: Severus gives no haplotype) with the TSG bonus
                { def stk11 = path(process.out.by_gene.get(0).get(1)).readLines().find { l -> l.startsWith('STK11\t') }?.split('\t', -1)
                  assert stk11 && stk11[4] == 'NEUT' && stk11[8] == 'NEUT' && stk11[2] == '6' && stk11[12] == 'HIGH_ONCO' &&
                      stk11[13].contains('severus_DEL1') && stk11[13].contains('between_exons') },
                { assert svs_by_id['severus_INS1'][24].startsWith('chr19:118') },
                { assert path(process.out.by_gene.get(0).get(1)).text.contains('STK11') },
                { assert path(process.out.log.get(0).get(1)).text.contains('Padfoot completed successfully') },
                // stable outputs: both tables, file names and the tool versions
                { assert snapshot(
                    process.out.annotated_svs,
                    process.out.by_gene,
                    file(process.out.log.get(0).get(1)).name,
                    process.out.versions
                ).match() }
            )
        }
    }

    test("savana + savana - real, RepeatMasker off") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', paired_data:'test' ],
                    file("${projectDir}/tests/fixtures/padfoot_reconplot/test_tumor.classified.somatic.vcf", checkIfExists: true),
                    'savana',
                    file("${projectDir}/tests/fixtures/padfoot_reconplot/test_tumor_segmented_absolute_copy_number.tsv", checkIfExists: true),
                    'savana',
                    file("${projectDir}/tests/fixtures/padfoot_reconplot/test_tumor_fitted_purity_ploidy.tsv", checkIfExists: true)
                ]
                input[1] = [ [ id:'ref' ], file("${projectDir}/tests/fixtures/padfoot_reconplot/chr19_1-2Mb.fasta", checkIfExists: true) ]
                input[2] = [ [ id:'ref' ], file("${projectDir}/tests/fixtures/padfoot_reconplot/chr19_1-2Mb.fasta.fai", checkIfExists: true) ]
                input[3] = [ [:], 'hg38', [], [] ]
                """
            }
        }

        then {
            def svs = path(process.out.annotated_svs.get(0).get(1)).readLines()
            def svs_by_id = svs.drop(1).collectEntries { line -> def f = line.split('\t', -1); [(f[0]): f] }
            assertAll(
                { assert process.success },
                // SAVANA breakend pairs are reported once under the shared ID; the <INS> record has no sequence to map
                { assert svs_by_id.keySet() == ['ID_1', 'ID_2', 'ID_3', 'ID_4', 'ID_5'] as Set },
                { assert svs_by_id['ID_1'][9] == 'HIGH_ONCO' && svs_by_id['ID_1'][11] == 'STK11' && svs_by_id['ID_1'][20] == 'between_exons' },
                { assert svs_by_id['ID_1'][7] == '+-' && svs_by_id['ID_2'][7] == '-+' && svs_by_id['ID_4'][7] == '++' && svs_by_id['ID_5'][7] == '--' },
                // SAVANA copy numbers are rounded before labelling against the fitted ploidy: the gain region is AMP on HP1, the loss NEUT/DEL
                { assert path(process.out.by_gene.get(0).get(1)).readLines().find { l -> l.startsWith('TCF3\t') }?.split('\t')?.getAt(4) == 'AMP' },
                { assert path(process.out.log.get(0).get(1)).text.contains('Padfoot completed successfully') },
                { assert snapshot(
                    process.out.annotated_svs,
                    process.out.by_gene,
                    file(process.out.log.get(0).get(1)).name,
                    process.out.versions
                ).match() }
            )
        }
    }
}
