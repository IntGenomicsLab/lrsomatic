nextflow_process {

    name "Test Process CORAL_CYCLE"
    script "../main.nf"
    process "CORAL_CYCLE"

    tag "modules"
    tag "modules_local"
    tag "coral_cycle"
    tag "small"

    // Stub only: the real tool needs a BAM, a solver and, for the classifier, a ~1 GB data repo.
    test("stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'sample1' ],
                    file('reconstruct')
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },

                { assert snapshot(process.out).match() }
            )
        }
    }
}
