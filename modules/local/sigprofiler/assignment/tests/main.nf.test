nextflow_process {

    name "Test Process SIGPROFILER_ASSIGNMENT"
    script "../main.nf"
    process "SIGPROFILER_ASSIGNMENT"

    tag "modules"
    tag "modules_local"
    tag "sigprofiler"
    tag "sigprofiler_assignment"
    tag "small"

    // Under -stub; the versions eval still runs in the pinned image, so its tag must resolve under each profile

    test("stub") {

        options "-stub"

        when {
            process {
                """
                // the stub reads neither the output dir nor the matrix; any file stands in for the SBS96 matrix
                def spmg   = file("\${projectDir}/tests/fixtures/sigprofiler_stub_volume", checkIfExists: true)
                def matrix = file("\${projectDir}/tests/fixtures/sigprofiler_stub_volume/tsb/CHM13-T2T/1.txt", checkIfExists: true)
                input[0] = [ [ id:'sample1' ], spmg, matrix, [], [] ]
                input[1] = 'CHM13-T2T'
                input[2] = 3.6
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.activities.size() == 1 },
                { assert process.out.probabilities_per_mutation.size() == 1 },
                { assert process.out.versions_sigprofilerassignment.size() == 1 },
                { assert process.out.versions_sigprofilerassignment[0][2] ==~ /\d+\.\d+.*/ }
            )
        }
    }

    // Real fit on synthetic matrices and seqinfo; the matrix fit needs no genome payload
    ['GRCh38', 'CHM13-T2T'].each { genome ->
        test("${genome} - per-mutation probabilities for every fitted context") {

            when {
                process {
                    """
                    def fixture = "\${projectDir}/tests/fixtures/sigprofiler_assignment"
                    input[0] = [
                        [ id:'sample1' ],
                        file("\${fixture}/output", checkIfExists: true),
                        file("\${fixture}/matrices/sample1.SBS96.all", checkIfExists: true),
                        file("\${fixture}/matrices/sample1.DBS78.all", checkIfExists: true),
                        file("\${fixture}/matrices/sample1.ID83.all", checkIfExists: true)
                    ]
                    input[1] = '${genome}'
                    input[2] = 3.6
                    """
                }
            }

            then {
                def fixture = "${baseDir}/tests/fixtures/sigprofiler_assignment"
                def tables  = process.out.probabilities_per_mutation[0][1]
                assert process.success
                assert process.out.activities[0][1].size() == 3
                assert tables.size() == 3
                ['SBS96', 'DBS78', 'ID83'].each { ctx ->
                    def lines = path(tables.find { it.contains("/${ctx}/") }).readLines()
                    def total = path("${fixture}/matrices/sample1.${ctx}.all").readLines().drop(1).sum { it.tokenize('\t')[1] as int }
                    assert lines[0].startsWith('Sample Names\tChr\tPos\tMutationType\t')
                    assert lines.size() - 1 == total
                }
            }
        }
    }
}
