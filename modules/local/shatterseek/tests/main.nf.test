nextflow_process {

    name "Test Process SHATTERSEEK"
    script "../main.nf"
    process "SHATTERSEEK"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "shatterseek"
    // "small" is what .github/workflows/nf-test.yml selects on for pull_request
    tag "small"

    // The stub tests check the I/O contract; the "real" tests run the wrapper and the ShatterSeek fork on the synthetic
    // event in tests/fixtures/shatterseek (chr19 chromothripsis linked to chr7, an isolated chr2 deletion), written in
    // each caller's own layout. Every pair must call chr19 high confidence (HC1, HC2) and nothing else.

    test("ascat + severus - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    'ascat',
                    [ file("${projectDir}/tests/fixtures/shatterseek/ascat/test.segments.txt", checkIfExists: true) ],
                    'severus',
                    [ file("${projectDir}/tests/fixtures/shatterseek/severus/severus_somatic.vcf.gz", checkIfExists: true) ]
                ]
                input[1] = [ [ id:'shatterseek' ], file("${projectDir}/assets/shatterseek", checkIfExists: true) ]
                input[2] = [ [ id:'reconplot' ], file("${projectDir}/assets/reconplot", checkIfExists: true) ]
                input[3] = 'hg38'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("savana single source - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    'savana',
                    [ file("${projectDir}/tests/fixtures/shatterseek/savana/test_tumor_segmented_absolute_copy_number.tsv", checkIfExists: true),
                      file("${projectDir}/tests/fixtures/shatterseek/savana/test_tumor.classified.somatic.vcf", checkIfExists: true) ],
                    'savana',
                    []
                ]
                input[1] = [ [ id:'shatterseek' ], file("${projectDir}/assets/shatterseek", checkIfExists: true) ]
                input[2] = [ [ id:'reconplot' ], file("${projectDir}/assets/reconplot", checkIfExists: true) ]
                input[3] = 'hg38'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("ascat + severus - real") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    'ascat',
                    [ file("${projectDir}/tests/fixtures/shatterseek/ascat/test.segments.txt", checkIfExists: true) ],
                    'severus',
                    [ file("${projectDir}/tests/fixtures/shatterseek/severus/severus_somatic.vcf.gz", checkIfExists: true) ]
                ]
                input[1] = [ [ id:'shatterseek' ], file("${projectDir}/assets/shatterseek", checkIfExists: true) ]
                input[2] = [ [ id:'reconplot' ], file("${projectDir}/assets/reconplot", checkIfExists: true) ]
                input[3] = 'hg38'
                """
            }
        }

        then {
            def rows = path(process.out.summary.get(0).get(1)).readLines()
            def head = rows[0].split('\t') as List
            def called = rows.drop(1).collect { r -> r.split('\t', -1) }
                .findAll { r -> r[head.indexOf('chromothripsis_confidence')] != 'none' }
                .collect { r -> "${r[head.indexOf('chrom')]}:${r[head.indexOf('chromothripsis_confidence')]}:${r[head.indexOf('chromothripsis_criteria')]}" }
            def log_text = path(process.out.log.get(0).get(1)).text
            assertAll(
                { assert process.success },
                { assert called == ['chr19:high:HC1,HC2'] },
                { assert rows.size() == 24 },   // header + chromosomes 1-22 and X
                { assert log_text.contains('dropped 1 non-PASS VCF records') && log_text.contains('INS=1') },
                { assert process.out.plots.get(0).get(1).toString().endsWith('test_chr19.pdf') },
                { assert snapshot(process.out.summary, process.out.inputs, process.out.versions).match() }
            )
        }
    }

    test("wakhan + severus - real") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    'wakhan',
                    [ file("${projectDir}/tests/fixtures/shatterseek/wakhan/solution_rank_1/integer_profile.bed", checkIfExists: true) ],
                    'severus',
                    [ file("${projectDir}/tests/fixtures/shatterseek/severus/severus_somatic.vcf.gz", checkIfExists: true) ]
                ]
                input[1] = [ [ id:'shatterseek' ], file("${projectDir}/assets/shatterseek", checkIfExists: true) ]
                input[2] = [ [ id:'reconplot' ], file("${projectDir}/assets/reconplot", checkIfExists: true) ]
                input[3] = 'hg38'
                """
            }
        }

        then {
            def log_text = path(process.out.log.get(0).get(1)).text
            assertAll(
                { assert process.success },
                { assert log_text.contains('tiers: chr19 high (HC1,HC2)') },
                // the subclonal chr7 haplotype state (1 + 1.2) is rounded to an integer total
                { assert log_text.contains('rounded 1 non-integer total copy numbers') },
                { assert snapshot(process.out.summary, process.out.inputs, process.out.versions).match() }
            )
        }
    }

    test("savana single source - real") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    'savana',
                    [ file("${projectDir}/tests/fixtures/shatterseek/savana/test_tumor_segmented_absolute_copy_number.tsv", checkIfExists: true),
                      file("${projectDir}/tests/fixtures/shatterseek/savana/test_tumor.classified.somatic.vcf", checkIfExists: true) ],
                    'savana',
                    []
                ]
                input[1] = [ [ id:'shatterseek' ], file("${projectDir}/assets/shatterseek", checkIfExists: true) ]
                input[2] = [ [ id:'reconplot' ], file("${projectDir}/assets/reconplot", checkIfExists: true) ]
                input[3] = 'hg38'
                """
            }
        }

        then {
            def sv_rows = path(process.out.inputs.get(0).get(1).find { f -> f.toString().endsWith('_sv_input.tsv') }).readLines()
            assertAll(
                { assert process.success },
                { assert path(process.out.log.get(0).get(1)).text.contains('tiers: chr19 high (HC1,HC2)') },
                // SAVANA writes BP_NOTATION in (_1, _2) order; the chr7 _2 records come first in the file, and the
                // translocations must keep the chr19 side's orientation (the same table as from Severus)
                { assert sv_rows.findAll { r -> r.contains('TRA') } == [
                    '19\t20500000\t7\t50100000\tTRA\t+\t-', '19\t22500000\t7\t50300000\tTRA\t-\t+',
                    '19\t24500000\t7\t50500000\tTRA\t+\t+', '19\t26500000\t7\t50700000\tTRA\t-\t-',
                    '19\t28500000\t7\t50900000\tTRA\t+\t-' ] },
                { assert snapshot(process.out.summary, process.out.inputs, process.out.versions).match() }
            )
        }
    }

    test("ascat + severus - real, chm13") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    'ascat',
                    [ file("${projectDir}/tests/fixtures/shatterseek/ascat/test.segments.txt", checkIfExists: true) ],
                    'severus',
                    [ file("${projectDir}/tests/fixtures/shatterseek/severus/severus_somatic.vcf.gz", checkIfExists: true) ]
                ]
                input[1] = [ [ id:'shatterseek' ], file("${projectDir}/assets/shatterseek", checkIfExists: true) ]
                input[2] = [ [ id:'reconplot' ], file("${projectDir}/assets/reconplot", checkIfExists: true) ]
                input[3] = 'chm13'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.log.get(0).get(1)).text.contains('tiers: chr19 high (HC1,HC2)') },
                { assert process.out.plots.get(0).get(1).toString().endsWith('test_chr19.pdf') }
            )
        }
    }
}
