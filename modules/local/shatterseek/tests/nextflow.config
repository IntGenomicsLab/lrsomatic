process {
    withName: 'SHATTERSEEK' {
        ext.prefix = { cn_source == sv_source ? "${cn_source}" : "${sv_source}_${cn_source}" }
        // as in conf/modules.config, so the real tests run the pipeline's default length filter (150 bp)
        ext.args   = { params.shatterseek_min_svlen ? "--min-svlen ${params.shatterseek_min_svlen}" : '' }
    }
}
