// The pipeline's RECONPLOT arguments (the '.*:RECONPLOT_*' block of conf/modules.config -- keep the two in sync),
// applied to the bare process name nf-test uses, with a focus panel (--regions with thousands separators, one known
// and one unknown gene, the BAF track) so the third Rscript call runs in CI too.
params {
    reconplot_max_cn       = 8
    reconplot_format       = 'pdf,png'
    reconplot_min_svlen    = 0
    reconplot_exclude_vntr = true
    reconplot_regions      = 'chr19:1,000,000-1,300,000'
    reconplot_genes        = 'STK11,NOTAGENE'
    reconplot_baf_track    = true
}

process {
    withName: 'RECONPLOT' {
        ext.prefix = { cn_source == sv_source ? "${cn_source}" : "${sv_source}_${cn_source}" }
        ext.args   = {
            [
                "--max-cn ${params.reconplot_max_cn}",
                "--format '${params.reconplot_format}'",
                params.reconplot_min_svlen ? "--min-svlen ${params.reconplot_min_svlen}" : '',
                (params.reconplot_exclude_vntr && sv_source == 'severus') ? '--exclude-vntr' : ''
            ].join(' ').trim()
        }
        ext.args2  = '--width 34 --height 4 --extra size_text=4,size_chr_labels=5,scale_ticks=50000000'
        ext.args3  = {
            params.reconplot_regions ? [
                "--regions '${params.reconplot_regions}'",
                params.reconplot_genes ? "--genes '${params.reconplot_genes}'" : '',
                (params.reconplot_baf_track && cn_source in ['ascat', 'savana']) ? '--baf-track' : ''
            ].join(' ').trim() : ''
        }
    }
}
