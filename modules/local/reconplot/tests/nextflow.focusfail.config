// A focus panel that cannot be drawn (the wrapper rejects an unknown option): the task must still succeed and keep
// its per-chromosome and genome-wide figures
process {
    withName: 'RECONPLOT' {
        ext.prefix = { cn_source == sv_source ? "${cn_source}" : "${sv_source}_${cn_source}" }
        ext.args3  = '--regions chr19 --no-such-option'
    }
}
