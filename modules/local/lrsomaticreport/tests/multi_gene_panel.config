/*
 * conf/modules.config is not loaded for module-level nf-test runs, so reproduce the
 * arguments it builds for `--report_gene_panel 'path/to/test_panel.tsv,path/to/test_panel_b.tsv,lymphoid'`:
 * one repeated `--gene-panel` flag per entry, staged TSVs as `gene_panels/<base name>`
 * and a builtin by its bare name.
 */
process {
    withName: 'LRSOMATICREPORT' {
        ext.args = "--gene-panel 'gene_panels/test_panel.tsv' --gene-panel 'gene_panels/test_panel_b.tsv' --gene-panel 'lymphoid'"
    }
}
