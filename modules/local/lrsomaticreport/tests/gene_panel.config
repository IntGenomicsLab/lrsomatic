/*
 * conf/modules.config is not loaded for module-level nf-test runs, so reproduce the
 * `--gene-panel` argument it builds. It passes `file(params.report_gene_panel).name`,
 * i.e. the base name -- which for a user-supplied TSV is the name the `gene_panel`
 * input stages it under in the task work dir.
 */
process {
    withName: 'LRSOMATICREPORT' {
        ext.args = "--gene-panel 'test_panel.tsv'"
    }
}
