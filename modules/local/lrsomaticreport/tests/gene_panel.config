/*
 * conf/modules.config is not loaded for module-level nf-test runs, so reproduce the
 * `--gene-panel` argument it builds. For a user-supplied TSV it passes
 * `gene_panels/<base name>`, i.e. the path the module's `gene_panels` input stages the
 * file at inside the task work dir.
 */
process {
    withName: 'LRSOMATICREPORT' {
        ext.args = "--gene-panel 'gene_panels/test_panel.tsv'"
    }
}
