nextflow_process {

    name "Test Process BCFTOOLS_CALLER_UNION"
    script "../main.nf"
    process "BCFTOOLS_CALLER_UNION"

    tag "modules"
    tag "modules_local"
    tag "bcftools_caller_union"
    tag "small"

    test("one record per position, PASS before the priority caller") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("\${projectDir}/tests/fixtures/callerunion_prio.vcf.gz", checkIfExists: true),
                    file("\${projectDir}/tests/fixtures/callerunion_prio.vcf.gz.tbi", checkIfExists: true),
                    file("\${projectDir}/tests/fixtures/callerunion_other.vcf.gz", checkIfExists: true),
                    file("\${projectDir}/tests/fixtures/callerunion_other.vcf.gz.tbi", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success

            def kept = path(process.out.vcf[0][1]).linesGzip
                .findAll { line -> !line.startsWith('#') }
                .collect { line -> def f = line.split('\t'); "${f[1]}:${f[6]}:${f[7]}" }

            // 200: the other caller's PASS beats the priority LowQual; 300: both non-PASS, priority wins;
            // 800/900: one caller's two records at one position keep one, PASS first
            assert kept == [
                '100:PASS:CALLER=clair3',
                '200:PASS:CALLER=deepvariant',
                '300:RefCall:CALLER=clair3',
                '400:RefCall:CALLER=deepvariant',
                '500:PASS:CALLER=clair3',
                '600:LowQual:CALLER=clair3',
                '700:PASS:CALLER=deepvariant',
                '800:RefCall:CALLER=clair3',
                '900:PASS:CALLER=deepvariant'
            ]
        }
    }

    test("stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test' ], [], [], [], [] ]
                """
            }
        }

        then {
            assert process.success
        }
    }
}
