nextflow_process {

    name "Test Process BCFTOOLS_CALLER_UNION"
    script "../main.nf"
    process "BCFTOOLS_CALLER_UNION"

    tag "modules"
    tag "modules_local"
    tag "bcftools_caller_union"
    tag "small"

    test("one caller per position, PASS before the priority caller, exact duplicates dropped") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("\${projectDir}/tests/fixtures/callerunion_prio.vcf.gz", checkIfExists: true),
                    file("\${projectDir}/tests/fixtures/callerunion_prio.vcf.gz.tbi", checkIfExists: true),
                    file("\${projectDir}/tests/fixtures/callerunion_other.vcf.gz", checkIfExists: true),
                    file("\${projectDir}/tests/fixtures/callerunion_other.vcf.gz.tbi", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success

            def kept = path(process.out.vcf[0][1]).linesGzip
                .findAll { line -> !line.startsWith('#') }
                .collect { line -> def f = line.split('\t'); "${f[1]}:${f[4]}:${f[6]}:${f[7]}" }

            // 200: the other caller's PASS beats the priority LowQual; 300: both non-PASS, priority wins;
            // 800: one caller's two alleles at one position are both kept (the phasing rejoin joins them);
            // 900: a PASS record hides the same caller's non-PASS record at its position;
            // 1000: an exact duplicate is kept once; 1100: the priority caller's SNV and insertion at one POS
            // are both kept, and the other caller's record there is not
            assert kept == [
                '100:T:PASS:CALLER=clair3',
                '200:A:PASS:CALLER=deepvariant',
                '300:A:RefCall:CALLER=clair3',
                '400:T:RefCall:CALLER=deepvariant',
                '500:C:PASS:CALLER=clair3',
                '600:G:LowQual:CALLER=clair3',
                '700:T:PASS:CALLER=deepvariant',
                '800:GA:RefCall:CALLER=clair3',
                '800:GAA:LowQual:CALLER=clair3',
                '900:CTT:PASS:CALLER=deepvariant',
                '1000:C:PASS:CALLER=clair3',
                '1100:ATTT:PASS:CALLER=clair3',
                '1100:G:PASS:CALLER=clair3'
            ]
        }
    }

    test("stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test' ], [], [], [], [] ]
                """
            }
        }

        then {
            assert process.success
        }
    }
}
